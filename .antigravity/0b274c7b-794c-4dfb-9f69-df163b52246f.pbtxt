        target_content: "import React from \'react\';\nimport { MandiPriceRecord, PriceForecast } from \'../types\';\nimport { TrendingUp, Store, DollarSign, Calendar, AlertCircle } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface MarketTrendsCardProps {\n  records: MandiPriceRecord[];\n  forecast: PriceForecast;\n}\n\nexport const MarketTrendsCard: React.FC<MarketTrendsCardProps> = ({ records, forecast }) => {"
        replacement_content: "import React, { useState } from \'react\';\nimport { MandiPriceRecord, PriceForecast } from \'../types\';\nimport { TrendingUp, Store, DollarSign, Calendar, AlertCircle, RefreshCw } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface MarketTrendsCardProps {\n  records: MandiPriceRecord[];\n  forecast: PriceForecast;\n  onRefresh?: () => void;\n}\n\nexport const MarketTrendsCard: React.FC<MarketTrendsCardProps> = ({ records, forecast, onRefresh }) => {\n  const [isRefreshing, setIsRefreshing] = useState(false);\n  const [lastRefreshedAt, setLastRefreshedAt] = useState<string>(new Date().toLocaleTimeString());\n\n  const handleRefreshClick = async () => {\n    setIsRefreshing(true);\n    setLastRefreshedAt(new Date().toLocaleTimeString());\n    if (onRefresh) {\n      await onRefresh();\n    }\n    setTimeout(() => setIsRefreshing(false), 500);\n  };"
      }
      num_matches: 1
