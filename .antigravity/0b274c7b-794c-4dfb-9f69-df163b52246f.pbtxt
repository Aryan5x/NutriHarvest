        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      // Model formula representing agricultural response function"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      const phFactor = Math.max(0.7, 1 - Math.abs(ph - crop.phOpt) * 0.2);"
