    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { SupabaseService } from \'../backend/supabase_service\';\nimport { User, Lock, Mail, X, CheckCircle2, ShieldCheck, LogOut } from \'lucide-react\';\nimport { UserSession } from \'../types\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  session: UserSession;\n  setSession: React.Dispatch<React.SetStateAction<UserSession>>;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  session,\n  setSession,\n}) => {\n  const [isSignUp, setIsSignUp] = useState(false);\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [farmerName, setFarmerName] = useState(\'\');\n  const [message, setMessage] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleAuth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setMessage(null);\n\n    try {\n      if (isSignUp) {\n        const { user, error } = await SupabaseService.signUp(email, password, farmerName || \'Ramesh Kumar\');\n        if (error) throw error;\n\n        setMessage({ type: \'success\', text: \'Account created! Profile synced with Supabase PostgreSQL.\' });\n        setSession({\n          user: { id: user?.id || \'usr_1\', email, farmerName: farmerName || \'Ramesh Kumar\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n      } else {\n        const { user, error } = await SupabaseService.signIn(email, password);\n        if (error) throw error;\n\n        setMessage({ type: \'success\', text: \'Logged in successfully! RLS protected state active.\' });\n        setSession({\n          user: { id: user?.id || \'usr_1\', email, farmerName: \'Ramesh Kumar\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n      }\n    } catch (err: any) {\n      setMessage({ type: \'error\', text: err.message || \'Authentication failed\' });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    await SupabaseService.signOut();\n    setSession({ user: null, isLoggedIn: false, isOffline: false, lastSyncedAt: new Date().toLocaleTimeString() });\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4\">\n      <div className=\"bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden relative\">\n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1 rounded-lg\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"p-6 space-y-4\">\n          <div className=\"flex items-center space-x-2\">\n            <ShieldCheck className=\"w-6 h-6 text-emerald-600\" />\n            <h2 className=\"text-xl font-bold text-slate-900\">\n              {session.isLoggedIn ? \'User Profile & Supabase Auth\' : isSignUp ? \'Create Supabase Account\' : \'Farmer Login\'}\n            </h2>\n          </div>\n\n          {session.isLoggedIn ? (\n            <div className=\"space-y-4 pt-2\">\n              <div className=\"bg-emerald-50 p-4 rounded-xl border border-emerald-200 space-y-2 text-xs\">\n                <div className=\"flex items-center space-x-2 text-emerald-800 font-bold\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                  <span>Authenticated Session Active</span>\n                </div>\n                <p className=\"text-slate-700\">Email: {session.user?.email}</p>\n                <p className=\"text-slate-700\">Farmer: {session.user?.farmerName}</p>\n                <p className=\"text-slate-500 text-[10px]\">Supabase Row Level Security (RLS) Active</p>\n              </div>\n\n              <button\n                onClick={handleSignOut}\n                className=\"w-full bg-rose-600 hover:bg-rose-700 text-white py-2.5 rounded-xl font-medium text-sm flex items-center justify-center space-x-2\"\n              >\n                <LogOut className=\"w-4 h-4\" />\n                <span>Sign Out</span>\n              </button>\n            </div>\n          ) : (\n            <form onSubmit={handleAuth} className=\"space-y-4 pt-2\">\n              {message && (\n                <div\n                  className={`p-3 rounded-xl text-xs font-medium ${\n                    message.type === \'success\' ? \'bg-emerald-50 text-emerald-800 border border-emerald-200\' : \'bg-rose-50 text-rose-800 border border-rose-200\'\n                  }`}\n                >\n                  {message.text}\n                </div>\n              )}\n\n              {isSignUp && (\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Farmer Full Name</label>\n                  <div className=\"relative\">\n                    <User className=\"w-4 h-4 text-slate-400 absolute left-3 top-3\" />\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ramesh Kumar\"\n                      value={farmerName}\n                      onChange={(e) => setFarmerName(e.target.value)}\n                      className=\"w-full pl-9 pr-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none\"\n                    />\n                  </div>\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Email Address</label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 text-slate-400 absolute left-3 top-3\" />\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"farmer@example.com\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    className=\"w-full pl-9 pr-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Password</label>\n                <div className=\"relative\">\n                  <Lock className=\"w-4 h-4 text-slate-400 absolute left-3 top-3\" />\n                  <input\n                    type=\"password\"\n                    required\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    value={password}\n                    onChange={(e) => setPassword(e.target.value)}\n                    className=\"w-full pl-9 pr-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={loading}\n                className=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-xl font-medium text-sm transition-all\"\n              >\n                {loading ? \'Processing...\' : isSignUp ? \'Create Supabase Account\' : \'Sign In\'}\n              </button>\n\n              <div className=\"text-center pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsSignUp(!isSignUp)}\n                  className=\"text-xs text-emerald-600 hover:text-emerald-700 font-semibold\"\n                >\n                  {isSignUp ? \'Already have an account? Sign in\' : \"Don\'t have an account? Create one\"}\n                </button>\n              </div>\n            </form>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { SupabaseService } from \'../backend/supabase_service\';\nimport { User, Lock, Mail, X, CheckCircle2, ShieldCheck, LogOut } from \'lucide-react\';\nimport { UserSession } from \'../types\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  session: UserSession;\n  setSession: React.Dispatch<React.SetStateAction<UserSession>>;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  session,\n  setSession,\n}) => {\n  const [isSignUp, setIsSignUp] = useState(false);\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [farmerName, setFarmerName] = useState(\'\');\n  const [message, setMessage] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleAuth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setMessage(null);\n\n    try {\n      if (isSignUp) {\n        const { user, error } = await SupabaseService.signUp(email, password, farmerName || \'Ramesh Kumar\');\n        if (error) throw error;\n\n        setMessage({ type: \'success\', text: \'Account created! Profile synced with Supabase PostgreSQL.\' });\n        setSession({\n          user: { id: user?.id || \'usr_1\', email, farmerName: farmerName || \'Ramesh Kumar\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n      } else {\n        const { user, error } = await SupabaseService.signIn(email, password);\n        if (error) throw error;\n\n        setMessage({ type: \'success\', text: \'Logged in successfully! RLS protected state active.\' });\n        setSession({\n          user: { id: user?.id || \'usr_1\', email, farmerName: \'Ramesh Kumar\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n      }\n    } catch (err: any) {\n      setMessage({ type: \'error\', text: err.message || \'Authentication failed\' });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    await SupabaseService.signOut();\n    setSession({ user: null, isLoggedIn: false, isOffline: false, lastSyncedAt: new Date().toLocaleTimeString() });\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-[#2D302D]/60 backdrop-blur-sm p-4\">\n      <div className=\"bg-white rounded-2xl shadow-xs border border-[#EBE7DF] w-full max-w-md overflow-hidden relative\">\n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 text-[#8C8F8C] hover:text-[#2D302D] p-1 rounded-lg\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"p-6 space-y-4\">\n          <div className=\"flex items-center space-x-2\">\n            <ShieldCheck className=\"w-6 h-6 text-[#4A6741]\" />\n            <h2 className=\"text-2xl font-serif italic text-[#4A6741]\">\n              {session.isLoggedIn ? \'User Profile & Supabase Auth\' : isSignUp ? \'Create Account\' : \'Farmer Login\'}\n            </h2>\n          </div>\n\n          {session.isLoggedIn ? (\n            <div className=\"space-y-4 pt-2\">\n              <div className=\"bg-[#F2F8F0] p-4 rounded-xl border border-[#4A6741]/20 space-y-2 text-xs\">\n                <div className=\"flex items-center space-x-2 text-[#4A6741] font-bold\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#4A6741]\" />\n                  <span>Authenticated Session Active</span>\n                </div>\n                <p className=\"text-[#2D302D]\">Email: {session.user?.email}</p>\n                <p className=\"text-[#2D302D]\">Farmer: {session.user?.farmerName}</p>\n                <p className=\"text-[#6B6E6B] text-[10px] font-mono\">Supabase Row Level Security (RLS) Active</p>\n              </div>\n\n              <button\n                onClick={handleSignOut}\n                className=\"w-full bg-[#8B5E34] hover:bg-[#6B4727] text-white py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider flex items-center justify-center space-x-2 transition-all\"\n              >\n                <LogOut className=\"w-4 h-4\" />\n                <span>Sign Out</span>\n              </button>\n            </div>\n          ) : (\n            <form onSubmit={handleAuth} className=\"space-y-4 pt-2\">\n              {message && (\n                <div\n                  className={`p-3 rounded-xl text-xs font-semibold ${\n                    message.type === \'success\' ? \'bg-[#F2F8F0] text-[#4A6741] border border-[#4A6741]/20\' : \'bg-[#FDF9F3] text-[#8B5E34] border border-[#D4A373]/40\'\n                  }`}\n                >\n                  {message.text}\n                </div>\n              )}\n\n              {isSignUp && (\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D302D] mb-1\">Farmer Full Name</label>\n                  <div className=\"relative\">\n                    <User className=\"w-4 h-4 text-[#8C8F8C] absolute left-3 top-3\" />\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ramesh Kumar\"\n                      value={farmerName}\n                      onChange={(e) => setFarmerName(e.target.value)}\n                      className=\"w-full pl-9 pr-3 py-2 border border-[#D9D4C7] rounded-xl text-xs focus:ring-1 focus:ring-[#4A6741] focus:border-[#4A6741] focus:outline-none text-[#2D302D]\"\n                    />\n                  </div>\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-xs font-bold text-[#2D302D] mb-1\">Email Address</label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 text-[#8C8F8C] absolute left-3 top-3\" />\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"farmer@example.com\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    className=\"w-full pl-9 pr-3 py-2 border border-[#D9D4C7] rounded-xl text-xs focus:ring-1 focus:ring-[#4A6741] focus:border-[#4A6741] focus:outline-none text-[#2D302D]\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-[#2D302D] mb-1\">Password</label>\n                <div className=\"relative\">\n                  <Lock className=\"w-4 h-4 text-[#8C8F8C] absolute left-3 top-3\" />\n                  <input\n                    type=\"password\"\n                    required\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    value={password}\n                    onChange={(e) => setPassword(e.target.value)}\n                    className=\"w-full pl-9 pr-3 py-2 border border-[#D9D4C7] rounded-xl text-xs focus:ring-1 focus:ring-[#4A6741] focus:border-[#4A6741] focus:outline-none text-[#2D302D]\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={loading}\n                className=\"w-full bg-[#4A6741] hover:bg-[#3A5033] text-white py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all\"\n              >\n                {loading ? \'Processing...\' : isSignUp ? \'Create Supabase Account\' : \'Sign In\'}\n              </button>\n\n              <div className=\"text-center pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsSignUp(!isSignUp)}\n                  className=\"text-xs text-[#4A6741] hover:text-[#3A5033] font-bold\"\n                >\n                  {isSignUp ? \'Already have an account? Sign in\' : \"Don\'t have an account? Create one\"}\n                </button>\n              </div>\n            </form>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};"
    }
