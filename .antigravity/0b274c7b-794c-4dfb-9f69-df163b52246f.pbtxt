  run_command {
    cwd: "."
    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    combined_output {
      full: "<truncated 25 bytes>\nn        // High future price -> store up to capacity\\n        storageKg = Math.min(storageCapacityKg, Math.round(remainingForMarketAndStorage * 0.6));\\n        marketSaleKg = remainingForMarketAndStorage - storageKg;\\n      } else {\\n        // Immediate sale preferred\\n        storageKg = Math.min(storageCapacityKg, Math.round(remainingForMarketAndStorage * 0.2));\\n        marketSaleKg = remainingForMarketAndStorage - storageKg;\\n      }\\n    }\\n\\n    // Financial Calculation\\n    const immediateMarketRevenue = marketSaleKg * mandiPrice.modalPricePerKg;\\n    const futureStorageRevenue = storageKg * forecast.forecastedModalPrice * 0.95; // 5% shrinkage loss\\n    const totalTransportCost = marketSaleKg * transportCostPerKgInr;\\n    const totalStorageCost = storageKg * storageCostPerKgInr;\\n    const cropProductionCost = crop.costPerAcreInr * crop.recommendedAcreage;\\n\\n    const netExpectedIncome = Math.round(\\n      immediateMarketRevenue + futureStorageRevenue - totalTransportCost - totalStorageCost - cropProductionCost\\n    );\\n\\n    // Verify Nutrition Coverage\\n    const familyHarvestMap = { [crop.id]: minFamilyKgRequired };\\n    const achievedNutrients = NutritionAgent.calculateHarvestNutritionalYield(familyHarvestMap);\\n    const coverageScore = NutritionAgent.computeNutritionCoverageScore(achievedNutrients, monthlyRda);\\n\\n    return {\\n      totalHarvestKg,\\n      familyConsumptionKg: minFamilyKgRequired,\\n      marketSaleKg,\\n      storageKg,\\n      emergencyBufferKg,\\n      seedReserveKg,\\n      netExpectedIncomeInr: netExpectedIncome,\\n      storageCostInr: Math.round(totalStorageCost),\\n      transportCostInr: Math.round(totalTransportCost),\\n      nutritionSatisfactionScorePercent: coverageScore.overallCoveragePercent,\\n      isFeasible,\\n      constraintWarnings,\\n    };\\n  }\\n}\\n\", \"/**\\n * GEMINI NATURAL LANGUAGE EXPLAINER & ORCHESTRATOR\\n * Server-Side Integration using @google/genai\\n * Model: gemini-3.6-flash\\n *\\n * Strict System Directive:\\n * \\\"Never invent numerical agricultural facts. Only use values supplied by tools/database.\\n * If information is missing, say that it is unavailable.\\\"\\n */\\n\\nimport { GoogleGenAI } from \'@google/genai\';\\n\\nlet aiClient: GoogleGenAI | null = null;\\n\\nfunction getGeminiClient(): GoogleGenAI {\\n  if (!aiClient) {\\n    const apiKey = process.env.GEMINI_API_KEY || \'MOCK_KEY\';\\n    aiClient = new GoogleGenAI({\\n      apiKey,\\n      httpOptions: {\\n        headers: {\\n          \'User-Agent\': \'aistudio-build\',\\n        },\\n      },\\n    });\\n  }\\n  return aiClient;\\n}\\n\\nexport class GeminiExplainer {\\n  /**\\n   * Explain the generated farm plan, harvest allocation, and climate alerts in simple language\\n   */\\n  static async explainFarmPlan(\\n    structuredData: any,\\n    targetLanguage: string = \'English\'\\n  ): Promise<{ text: string; language: string }> {\\n    try {\\n      const ai = getGeminiClient();\\n      const prompt = `You are NutriHarvest AI Assistant. Explain the following structured farm plan to the smallholder farmer in warm, clear, simple, encouraging language (${targetLanguage}).\\n\\nRULES:\\n- Do NOT invent or alter any numerical values (yield, price, income, coverage %).\\n- Use ONLY the provided JSON facts.\\n- Highlight why the selected crops balance household nutrition and market income.\\n- Include a practical 2-step action item.\\n\\nSTRUCTURED FARM PLAN DATA:\\n${JSON.stringify(structuredData, null, 2)}`;\\n\\n      const response = await ai.models.generateContent({\\n        model: \'gemini-3.6-flash\',\\n        contents: prompt,\\n        config: {\\n          systemInstruction:\\n            \'You are an authoritative agricultural decision support explainer. Never invent numerical facts, prices, weather, or crop yields. Only explain the facts provided in the prompt.\',\\n          temperature: 0.3,\\n        },\\n      });\\n\\n      return {\\n        text: response.text || \'Farm plan generated successfully based on ICMR nutrition RDA and AGMARKNET market prices.\',\\n        language: targetLanguage,\\n      };\\n    } catch (err) {\\n      console.warn(\'Gemini API call failed, falling back to deterministic explanation:\', err);\\n      return {\\n        text: `Your NutriHarvest AI crop plan is optimized for ${structuredData?.farm?.landAreaAcres || 2.5} acres. It balances 3-month household nutrition requirements with peak market returns.`,\\n        language: targetLanguage,\\n      };\\n    }\\n  }\\n\\n  /**\\n   * Farmer Interactive Q&A Assistant\\n   */\\n  static async answerFarmerQuery(\\n    userQuery: string,\\n    farmContext: any,\\n    targetLanguage: string = \'English\'\\n  ): Promise<string> {\\n    try {\\n      const ai = getGeminiClient();\\n      const prompt = `Farmer Question: \\\"${userQuery}\\\"\\nTarget Language: ${targetLanguage}\\nFarmer Context: ${JSON.stringify(farmContext)}\\n\\nAnswer clearly in simple language for a smallholder farmer in ${targetLanguage}. Keep responses practical and non-jargon.`;\\n\\n      const response = await ai.models.generateContent({\\n        model: \'gemini-3.6-flash\',\\n        contents: prompt,\\n        config: {\\n          systemInstruction:\\n            \'You are NutriHarvest AI farmer advisor. Never invent prices or weather. Be helpful and clear.\',\\n          temperature: 0.4,\\n        },\\n      });\\n\\n      return response.text || \'I am ready to help you optimize your crop plan and harvest decisions.\';\\n    } catch (err) {\\n      return `Answer for: \\\"${userQuery}\\\" - Please consult your local Krishi Vigyan Kendra (KVK) for specific field queries if offline.`;\\n    }\\n  }\\n}\\n\", \"/**\\n * NutriHarvest AI Data Provenance Registry\\n */\\n\\nimport { DataProvenanceItem } from \'../types\';\\n\\nexport const PROVENANCE_REGISTRY: DataProvenanceItem[] = [\\n  {\\n    id: \'DS_IFCT2017\',\\n    name: \'Indian Food Composition Tables (IFCT 2017)\',\\n    provider: \'ICMR - National Institute of Nutrition (NIN), Hyderabad\',\\n    sourceUrl: \'https://www.nin.res.in/ebooks/IFCT2017_16122024.pdf\',\\n    retrievedAt: \'2026-08-10\',\\n    license: \'ICMR-NIN Educational & Research License\',\\n    description: \'Authoritative chemical composition & nutritional database for Indian food items across 7 key macronutrients & micronutrients.\',\\n    status: \'VERIFIED_SNAPSHOT\',\\n  },\\n  {\\n    id: \'DS_AGMARKNET\',\\n    name: \'Daily Wholesale Mandi Market Prices\',\\n    provider: \'Government of India Data.gov.in / AGMARKNET\',\\n    sourceUrl: \'https://www.data.gov.in/catalog/current-daily-price-various-commodities-various-markets-mandi\',\\n    retrievedAt: \'2026-08-11\',\\n    license: \'Open Government Data License (OGDL) India\',\\n    description: \'Official wholesale commodity price feed (Modal, Min, Max prices) across APMC mandis in Indian districts.\',\\n    status: \'LIVE_CONNECTED\',\\n  },\\n  {\\n    id: \'DS_OPEN_METEO\',\\n    name: \'Hyperlocal Weather & Climate Forecast API\',\\n    provider: \'Open-Meteo Weather API\',\\n    sourceUrl: \'https://open-meteo.com/en/docs\',\\n    retrievedAt: \'2026-08-11\',\\n    license: \'Non-commercial Attribution (CC BY 4.0)\',\\n    description: \'High-resolution hourly weather forecasts, rainfall probabilities, evapotranspiration (ET0), and heat index alerts.\',\\n    status: \'LIVE_CONNECTED\',\\n  },\\n  {\\n    id: \'DS_SOILGRIDS\',\\n    name: \'ISRIC SoilGrids REST API v2.0\',\\n    provider: \'ISRIC - World Soil Information\',\\n    sourceUrl: \'https://rest.isric.org/soilgrids/v2.0/docs\',\\n    retrievedAt: \'2026-08-10\',\\n    license: \'CC BY 4.0 International\',\\n    description: \'Global 250m spatial resolution soil property predictions (pH, organic carbon, clay/sand/silt content, bulk density).\',\\n    status: \'LIVE_CONNECTED\',\\n  },\\n  {\\n    id: \'DS_CROP_YIELD\',\\n    name: \'Agricultural Crop Yield in Indian States Dataset (1997-2020)\',\\n    provider: \'Ministry of Agriculture & Farmers Welfare / Kaggle Open Data\',\\n    sourceUrl: \'https://www.kaggle.com/datasets/akshatgupta7/crop-yield-in-indian-states-dataset\',\\n    retrievedAt: \'2026-08-09\',\\n    license: \'Database Contents License (DbCL)\',\\n    description: \'Historical crop yield dataset for training the XGBoost yield predictor with 12 features excluding Production to prevent target leakage.\',\\n    status: \'VERIFIED_SNAPSHOT\',\\n  },\\n];\\n\"],"
    }
    command_line: "grep -rn -i \"agmarknet\" ."
    proposed_command_line: "grep -rn -i \"agmarknet\" ."
    shell_name: "bash"
