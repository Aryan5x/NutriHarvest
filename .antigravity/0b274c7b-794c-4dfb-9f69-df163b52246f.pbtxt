  file_change {
    absolute_path_uri: "file:///src/backend/supabase_service.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * SUPABASE SERVICE & AUTHENTICATION CLIENT\n * Handles Supabase auth, RLS database tables, and persistent profile storage.\n */\n\nimport { createClient } from \'@supabase/supabase-js\';\n\nconst supabaseUrl = import.meta.env.VITE_SUPABASE_URL || \'https://placeholder-supabase-url.supabase.co\';\nconst supabaseAnonKey = import.meta.env.VITE_SUPABASE_ANON_KEY || \'placeholder-anon-key\';\n\nexport const supabase = createClient(supabaseUrl, supabaseAnonKey);\n\nexport interface SupabaseProfile {\n  id: string;\n  email: string;\n  farmer_name: string;\n  created_at?: string;\n}\n\nexport class SupabaseService {\n  static isConfigured(): boolean {\n    return (\n      import.meta.env.VITE_SUPABASE_URL !== undefined &&\n      import.meta.env.VITE_SUPABASE_URL !== \'\' &&\n      !import.meta.env.VITE_SUPABASE_URL.includes(\'placeholder\')\n    );\n  }\n\n  static async signUp(email: string, password: string, farmerName: string) {\n    if (!this.isConfigured()) {\n      // Mock local session for offline / dev demo\n      const localUser = { id: \'usr_demo_101\', email, farmerName };\n      localStorage.setItem(\'nutriharvest_user\', JSON.stringify(localUser));\n      return { user: localUser, error: null };\n    }\n\n    const { data, error } = await supabase.auth.signUp({\n      email,\n      password,\n      options: {\n        data: { farmer_name: farmerName },\n      },\n    });\n\n    if (data.user && !error) {\n      await supabase.from(\'profiles\').insert([\n        {\n          id: data.user.id,\n          email,\n          farmer_name: farmerName,\n        },\n      ]);\n    }\n\n    return { user: data.user, error };\n  }\n\n  static async signIn(email: string, password: string) {\n    if (!this.isConfigured()) {\n      const localUser = { id: \'usr_demo_101\', email, farmerName: \'Ramesh Kumar\' };\n      localStorage.setItem(\'nutriharvest_user\', JSON.stringify(localUser));\n      return { user: localUser, error: null };\n    }\n\n    const { data, error } = await supabase.auth.signInWithPassword({\n      email,\n      password,\n    });\n\n    return { user: data.user, error };\n  }\n\n  static async signOut() {\n    if (!this.isConfigured()) {\n      localStorage.removeItem(\'nutriharvest_user\');\n      return { error: null };\n    }\n\n    const { error } = await supabase.auth.signOut();\n    return { error };\n  }\n\n  static async getCurrentUser() {\n    if (!this.isConfigured()) {\n      const stored = localStorage.getItem(\'nutriharvest_user\');\n      return stored ? JSON.parse(stored) : null;\n    }\n\n    const { data } = await supabase.auth.getUser();\n    return data.user;\n  }\n}\n"
    }
    diff {
      unified_diff {
