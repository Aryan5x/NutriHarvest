: \'Cereal\',\n    per100g: {\n      proteinGrams: 11.1,\n      ironMg: 2.3,\n      calciumMg: 10,\n      vitaminAMcg: 90,\n      vitaminCMg: 0,\n      fiberGrams: 12.2,\n      caloriesKcal: 342,\n    },\n    provenance: \'ICMR-NIN IFCT 2017 (Table A.4 Dry Maize Grain)\',\n  },\n  CHICKPEA: {\n    cropId: \'CHICKPEA\',\n    cropName: \'Bengal Gram / Chickpea / Chana (Cicer arietinum)\',\n    category: \'Pulse\',\n    per100g: {\n      proteinGrams: 20.1,\n      ironMg: 5.3,\n      calciumMg: 149,\n      vitaminAMcg: 189,\n      vitaminCMg: 3,\n      fiberGrams: 25.2,\n      caloriesKcal: 360,\n    },\n    provenance: \'ICMR-NIN IFCT 2017 (Table B.1 Whole Bengal Gram)\',\n  },\n  PIGEON_PEA: {\n    cropId: \'PIGEON_PEA\',\n    cropName: \'Red Gram / Pigeon Pea / Tur (Cajanus cajan)\',\n    category: \'Pulse\',\n    per100g: {\n      proteinGrams: 22.3,\n      ironMg: 2.7,\n      calciumMg: 73,\n      vitaminAMcg: 132,\n      vitaminCMg: 0,\n      fiberGrams: 15.0,\n      caloriesKcal: 335,\n    },\n    provenance: \'ICMR-NIN IFCT 2017 (Table B.2 Red Gram Dal)\',\n  },\n  LENTIL: {\n    cropId: \'LENTIL\',\n    cropName: \'Lentil / Masoor (Lens culinaris)\',\n    category: \'Pulse\',\n    per100g: {\n      proteinGrams: 25.1,\n      ironMg: 7.5,\n      calciumMg: 69,\n      vitaminAMcg: 450,\n      vitaminCMg: 0,\n      fiberGrams: 10.7,\n      caloriesKcal: 343,\n    },\n    provenance: \'ICMR-NIN IFCT 2017 (Table B.4 Masoor Dal)\',\n  },\n  MOONG_BEAN: {\n    cropId: \'MOONG_BEAN\',\n    cropName: \'Green Gram / Moong (Vigna radiata)\',\n    category: \'Pulse\',\n    per100g: {\n      proteinGrams: 24.0,\n      ironMg: 4.4,\n      calciumMg: 124,\n      vitaminAMcg: 83,\n      vitaminCMg: 0,\n      fiberGrams: 16.3,\n      caloriesKcal: 334,\n    },\n    provenance: \'ICMR-NIN IFCT 2017 (Table B.3 Green Gram Whole)\',\n  },\n  GROUNDNUT: {\n    cropId: \'GROUNDNUT\',\n    cropName: \'Groundnut / Peanut (Arachis hypogaea)\',\n    category: \'Oilseed\',\n    per100g: 