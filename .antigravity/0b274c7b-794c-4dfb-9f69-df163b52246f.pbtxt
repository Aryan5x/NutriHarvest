        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      CROP_YIELD_TRAINING_RECORDS.push({"
