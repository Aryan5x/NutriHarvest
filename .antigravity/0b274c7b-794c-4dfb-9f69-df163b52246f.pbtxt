          text: "    const stateMean = this.stateTrainingMeans.get(sNorm) || this.trainingGlobalMean;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
