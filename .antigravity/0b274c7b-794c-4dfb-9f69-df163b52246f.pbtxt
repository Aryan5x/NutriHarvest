      original_chunk {
        target_content: "  /**\n   * Generate candidate crops with XGBoost yield predictions for a given farm\n   */\n  static generateCropPlan(farm: FarmProfile, season: Season): CandidateCrop[] {\n    const availableAcreage = farm.landAreaAcres;\n    const hectares = availableAcreage * 0.404686;\n\n    const cropCatalog: Array<{\n      id: string;\n      name: string;\n      category: CandidateCrop[\'category\'];\n      season: Season;\n      durationDays: number;\n      waterReqMm: number;\n      costPerAcreInr: number;\n      recommendedShare: number; // fraction of land\n    }> = [\n      { id: \'WHEAT\', name: \'Wheat\', category: \'Cereal\', season: \'RABI\', durationDays: 120, waterReqMm: 450, costPerAcreInr: 12000, recommendedShare: 0.4 },\n      { id: \'RICE\', name: \'Paddy / Rice\', category: \'Cereal\', season: \'KHARIF\', durationDays: 135, waterReqMm: 1100, costPerAcreInr: 15000, recommendedShare: 0.4 },\n      { id: \'CHICKPEA\', name: \'Chickpea (Chana)\', category: \'Pulse\', season: \'RABI\', durationDays: 110, waterReqMm: 250, costPerAcreInr: 8000, recommendedShare: 0.25 },\n      { id: \'BAJRA\', name: \'Pearl Millet (Bajra)\', category: \'Cereal\', season: \'KHARIF\', durationDays: 85, waterReqMm: 350, costPerAcreInr: 6500, recommendedShare: 0.25 },\n      { id: \'MUSTARD\', name: \'Mustard\', category: \'Oilseed\', season: \'RABI\', durationDays: 105, waterReqMm: 7500, costPerAcreInr: 7500, recommendedShare: 0.2 },\n      { id: \'TOMATO\', name: \'Tomato\', category: \'Vegetable\', season: \'ZAID\', durationDays: 90, waterReqMm: 600, costPerAcreInr: 22000, recommendedShare: 0.15 },\n      { id: \'POTATO\', name: \'Potato\', category: \'Tuber\', season: \'RABI\', durationDays: 100, waterReqMm: 500, costPerAcreInr: 18000, recommendedShare: 0.2 },\n      { id: \'ONION\', name: \'Onion\', category: \'Vegetable\', season: \'RABI\', durationDays: 115, waterReqMm: 400, costPerAcreInr: 16000, recommendedShare: 0.15 },\n    ];\n\n    const candidates: CandidateCrop[] = [];\n\n    for (const item of cropCatalog) {\n      if (season !== \'WHOLE_YEAR\' && item.season !== season && item.season !== \'ZAID\') {\n        continue;\n      }\n\n      const allocatedAcreage = Number((availableAcreage * item.recommendedShare).toFixed(2));\n      if (allocatedAcreage < 0.1) continue;\n\n      const yieldPerHa = this.predictYieldInternal({\n        crop: item.name,\n        state: farm.state,\n        season: item.season,\n        areaHa: hectares,\n        rainfallMm: farm.waterSource === \'RAINFED\' ? 450 : 800,\n        soilPH: farm.soil.pH,\n        fertilizerKgHa: 120,\n      });\n\n      // Convert kg/ha to kg/acre (1 ha = 2.471 acres)\n      const predictedYieldKgPerAcre = Math.round(yieldPerHa / 2.471);\n      const totalExpectedYieldKg = Math.round(predictedYieldKgPerAcre * allocatedAcreage);\n\n      candidates.push({\n        id: item.id,\n        name: item.name,\n        category: item.category,\n        season: item.season,\n        durationDays: item.durationDays,\n        waterReqMm: item.waterReqMm,\n        costPerAcreInr: item.costPerAcreInr,\n        recommendedAcreage: allocatedAcreage,\n        predictedYieldKgPerAcre,\n        totalExpectedYieldKg,\n        yieldConfidenceInterval: [Math.round(totalExpectedYieldKg * 0.9), Math.round(totalExpectedYieldKg * 1.1)],\n        xgboostFeatures: {\n          state: farm.state,\n          season: item.season,\n          area: allocatedAcreage,\n          rainfallMm: item.waterReqMm,\n          tempC: 24,\n          soilN: farm.soil.nitrogenKgHa,\n          soilP: farm.soil.phosphorusKgHa,\n          soilK: farm.soil.potassiumKgHa,\n        },\n      });\n    }\n\n    return candidates;\n  }"
        replacement_content: "  /**\n   * Generate candidate crops with XGBoost yield predictions and explicit user-specific recommendation reasons\n   */\n  static generateCropPlan(farm: FarmProfile, season: Season, deficientNutrients: string[] = []): CandidateCrop[] {\n    const availableAcreage = farm.landAreaAcres;\n    const hectares = availableAcreage * 0.404686;\n\n    const cropCatalog: Array<{\n      id: string;\n      name: string;\n      category: CandidateCrop[\'category\'];\n      season: Season;\n      durationDays: number;\n      waterReqMm: number;\n      costPerAcreInr: number;\n      recommendedShare: number; // fraction of land\n      idealSoilPhMin: number;\n      idealSoilPhMax: number;\n      nutritionalTargetTags: string[];\n    }> = [\n      {\n        id: \'WHEAT\',\n        name: \'Wheat\',\n        category: \'Cereal\',\n        season: \'RABI\',\n        durationDays: 120,\n        waterReqMm: 450,\n        costPerAcreInr: 12000,\n        recommendedShare: 0.4,\n        idealSoilPhMin: 6.0,\n        idealSoilPhMax: 7.8,\n        nutritionalTargetTags: [\'Calories\', \'Fiber\', \'Protein\'],\n      },\n      {\n        id: \'RICE\',\n        name: \'Paddy / Rice\',\n        category: \'Cereal\',\n        season: \'KHARIF\',\n        durationDays: 135,\n        waterReqMm: 1100,\n        costPerAcreInr: 15000,\n        recommendedShare: 0.4,\n        idealSoilPhMin: 5.5,\n        idealSoilPhMax: 7.5,\n        nutritionalTargetTags: [\'Calories\'],\n      },\n      {\n        id: \'CHICKPEA\',\n        name: \'Chickpea (Chana)\',\n        category: \'Pulse\',\n        season: \'RABI\',\n        durationDays: 110,\n        waterReqMm: 250,\n        costPerAcreInr: 8000,\n        recommendedShare: 0.25,\n        idealSoilPhMin: 6.0,\n        idealSoilPhMax: 8.0,\n        nutritionalTargetTags: [\'Protein\', \'Iron\', \'Calcium\', \'Fiber\'],\n      },\n      {\n        id: \'BAJRA\',\n        name: \'Pearl Millet (Bajra)\',\n        category: \'Cereal\',\n        season: \'KHARIF\',\n        durationDays: 85,\n        waterReqMm: 350,\n        costPerAcreInr: 6500,\n        recommendedShare: 0.25,\n        idealSoilPhMin: 6.2,\n        idealSoilPhMax: 8.2,\n        nutritionalTargetTags: [\'Iron\', \'Protein\', \'Calcium\'],\n      },\n      {\n        id: \'MUSTARD\',\n        name: \'Mustard\',\n        category: \'Oilseed\',\n        season: \'RABI\',\n        durationDays: 105,\n        waterReqMm: 300,\n        costPerAcreInr: 7500,\n        recommendedShare: 0.2,\n        idealSoilPhMin: 6.0,\n        idealSoilPhMax: 7.8,\n        nutritionalTargetTags: [\'Calcium\', \'Calories\'],\n      },\n      {\n        id: \'TOMATO\',\n        name: \'Tomato\',\n        category: \'Vegetable\',\n        season: \'ZAID\',\n        durationDays: 90,\n        waterReqMm: 600,\n        costPerAcreInr: 22000,\n        recommendedShare: 0.15,\n        idealSoilPhMin: 6.0,\n        idealSoilPhMax: 7.5,\n        nutritionalTargetTags: [\'Vitamin C\', \'Vitamin A\'],\n      },\n      {\n        id: \'POTATO\',\n        name: \'Potato\',\n        category: \'Tuber\',\n        season: \'RABI\',\n        durationDays: 100,\n        waterReqMm: 500,\n        costPerAcreInr: 18000,\n        recommendedShare: 0.2,\n        idealSoilPhMin: 5.2,\n        idealSoilPhMax: 6.8,\n        nutritionalTargetTags: [\'Calories\', \'Vitamin C\'],\n      },\n      {\n        id: \'ONION\',\n        name: \'Onion\',\n        category: \'Vegetable\',\n        season: \'RABI\',\n        durationDays: 115,\n        waterReqMm: 400,\n        costPerAcreInr: 16000,\n        recommendedShare: 0.15,\n        idealSoilPhMin: 6.0,\n        idealSoilPhMax: 7.5,\n        nutritionalTargetTags: [\'Vitamin C\', \'Calcium\'],\n      },\n    ];\n\n    const candidates: CandidateCrop[] = [];\n\n    for (const item of cropCatalog) {\n      if (season !== \'WHOLE_YEAR\' && item.season !== season && item.season !== \'ZAID\') {\n        continue;\n      }\n\n      const allocatedAcreage = Number((availableAcreage * item.recommendedShare).toFixed(2));\n      if (allocatedAcreage < 0.1) continue;\n\n      const yieldPerHa = this.predictYieldInternal({\n        crop: item.name,\n        state: farm.state,\n        season: item.season,\n        areaHa: hectares,\n        rainfallMm: farm.waterSource === \'RAINFED\' ? 450 : 800,\n        soilPH: farm.soil.pH,\n        fertilizerKgHa: 120,\n      });\n\n      // Convert kg/ha to kg/acre (1 ha = 2.471 acres)\n      const predictedYieldKgPerAcre = Math.round(yieldPerHa / 2.471);\n      const totalExpectedYieldKg = Math.round(predictedYieldKgPerAcre * allocatedAcreage);\n\n      // Generate explicit user-specific recommendation reasons\n      const reasons: string[] = [];\n\n      // 1. Soil Match\n      if (farm.soil.pH >= item.idealSoilPhMin && farm.soil.pH <= item.idealSoilPhMax) {\n        reasons.push(`\342\234\223 Excellent match for your ${farm.soil.type} soil pH (${farm.soil.pH})`);\n      } else {\n        reasons.push(`\342\234\223 Tolerant to your ${farm.soil.type} soil conditions`);\n      }\n\n      // 2. Climate & Water\n      if (farm.waterSource === \'RAINFED\' && item.waterReqMm <= 400) {\n        reasons.push(`\342\234\223 Low water requirement (${item.waterReqMm} mm) suits your Rainfed setup`);\n      } else if (farm.waterSource !== \'RAINFED\') {\n        reasons.push(`\342\234\223 Water requirement (${item.waterReqMm} mm) fits your ${farm.waterSource.replace(\'_\', \' \')} supply`);\n      }\n\n      // 3. Location & Season\n      reasons.push(`\342\234\223 Suitable for ${item.season} growing season in ${farm.district}, ${farm.state}`);\n\n      // 4. Nutritional Gaps Targeted\n      const matchingGaps = item.nutritionalTargetTags.filter((tag) =>\n        deficientNutrients.some((def) => def.toLowerCase().includes(tag.toLowerCase()))\n      );\n      if (matchingGaps.length > 0) {\n        reasons.push(`\342\234\223 Directly addresses household deficiency in ${matchingGaps.join(\' & \')}`);\n      } else {\n        reasons.push(`\342\234\223 Provides vital household ${item.nutritionalTargetTags.slice(0, 2).join(\' & \')} supply`);\n      }\n\n      // 5. Budget Feasibility\n      const totalCost = item.costPerAcreInr * allocatedAcreage;\n      if (totalCost <= farm.budgetInr) {\n        reasons.push(`\342\234\223 Cultivation cost (\342\202\271${totalCost.toLocaleString()}) is within your \342\202\271${farm.budgetInr.toLocaleString()} budget`);\n      }\n\n      // 6. Crop Rotation\n      if (farm.cropHistory.length > 0) {\n        const lastCrop = farm.cropHistory[farm.cropHistory.length - 1];\n        if (item.category === \'Pulse\' && lastCrop.toLowerCase().includes(\'wheat\')) {\n          reasons.push(`\342\234\223 Nitrogen-fixing pulse crop provides ideal rotation after ${lastCrop}`);\n        }\n      }\n\n      candidates.push({\n        id: item.id,\n        name: item.name,\n        category: item.category,\n        season: item.season,\n        durationDays: item.durationDays,\n        waterReqMm: item.waterReqMm,\n        costPerAcreInr: item.costPerAcreInr,\n        recommendedAcreage: allocatedAcreage,\n        predictedYieldKgPerAcre,\n        totalExpectedYieldKg,\n        yieldConfidenceInterval: [Math.round(totalExpectedYieldKg * 0.9), Math.round(totalExpectedYieldKg * 1.1)],\n        recommendationReasons: reasons,\n        xgboostFeatures: {\n          state: farm.state,\n          season: item.season,\n          area: allocatedAcreage,\n          rainfallMm: item.waterReqMm,\n          tempC: 24,\n          soilN: farm.soil.nitrogenKgHa,\n          soilP: farm.soil.phosphorusKgHa,\n          soilK: farm.soil.potassiumKgHa,\n        },\n      });\n    }\n\n    return candidates;\n  }"
