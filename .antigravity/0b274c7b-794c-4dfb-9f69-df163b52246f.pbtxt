        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { IFCT2017_CROP_NUTRITION, ICMR_DAILY_RDA } from \'../data/ifct2017_nutrition\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { HouseholdAgeGroups, HouseholdProfile, NutrientTarget, NutritionCoverageScore } from \'../types\';"
