  file_change {
    absolute_path_uri: "file:///src/backend/supabase_service.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  /**\n   * Retrieves onboarding data for a user from Supabase database (or local storage fallback)\n   */\n  static async getOnboardingProfile(userId: string): Promise<{\n    farmer: HouseholdProfile | null;\n    farm: FarmProfile | null;\n  }> {\n    // Try localStorage first for instant boot speed\n    let localData: { farmer: HouseholdProfile; farm: FarmProfile } | null = null;\n    try {\n      const stored = localStorage.getItem(`nutriharvest_onboarding_${userId}`) || localStorage.getItem(\'nutriharvest_current_onboarding\');\n      if (stored) {\n        localData = JSON.parse(stored);\n      }\n    } catch {\n      // ignore JSON errors\n    }\n\n    if (!this.isConfigured()) {\n      return {\n        farmer: localData?.farmer || null,\n        farm: localData?.farm || null,\n      };\n    }\n\n    try {\n      const { data, error } = await supabase\n        .from(\'farmer_onboarding\')\n        .select(\'*\')\n        .eq(\'user_id\', userId)\n        .maybeSingle();\n\n      if (data && !error) {\n        const farmer: HouseholdProfile = {\n          id: userId,\n          farmerName: data.farmer_name || \'Farmer\',\n          householdSize: data.household_size || 5,\n          ageGroups: data.age_groups || { children0_5: 1, children6_12: 1, teens13_18: 0, adults19_59: 2, seniors60Plus: 1 },\n          dietPreference: data.diet_preference || \'VEGETARIAN\',\n        };\n\n        const farm: FarmProfile = {\n          id: `farm_${userId}`,\n          farmerId: userId,\n          farmName: `${data.farmer_name || \'Farmer\'}\'s Field`,\n          state: data.state || \'Haryana\',\n          district: data.district || \'Karnal\',\n          latitude: 29.6857,\n          longitude: 76.9905,\n          landAreaAcres: data.land_area_acres || 2.5,\n          waterSource: data.water_source || \'IRRIGATED_BOREWELL\',\n          budgetInr: data.budget_inr || 25000,\n          cropHistory: data.crop_history || [\'Wheat\', \'Rice\'],\n          soil: {\n            type: data.soil_type || \'Alluvial Loam\',\n            pH: data.soil_ph || 7.2,\n            nitrogenKgHa: data.soil_nitrogen || 140,\n            phosphorusKgHa: data.soil_phosphorus || 28,\n            potassiumKgHa: 195,\n            organicCarbonPercent: 0.65,\n          },\n        };\n\n        return { farmer, farm };\n      }\n    } catch (err) {\n      console.warn(\'Note on fetching Supabase onboarding profile:\', err);\n    }\n\n    return {\n      farmer: localData?.farmer || null,\n      farm: localData?.farm || null,\n    };\n  }"
      replacement_content: "  /**\n   * Retrieves onboarding data for a user from Supabase database (or local storage fallback)\n   */\n  static async getOnboardingProfile(userId: string): Promise<{\n    farmer: HouseholdProfile | null;\n    farm: FarmProfile | null;\n    hasCompleted: boolean;\n  }> {\n    // Try localStorage first for instant boot speed\n    let localData: { farmer: HouseholdProfile; farm: FarmProfile } | null = null;\n    try {\n      const stored = localStorage.getItem(`nutriharvest_onboarding_${userId}`);\n      if (stored) {\n        localData = JSON.parse(stored);\n      }\n    } catch {\n      // ignore JSON errors\n    }\n\n    if (!this.isConfigured()) {\n      return {\n        farmer: localData?.farmer || null,\n        farm: localData?.farm || null,\n        hasCompleted: Boolean(localData?.farmer && localData?.farm),\n      };\n    }\n\n    try {\n      const { data, error } = await supabase\n        .from(\'farmer_onboarding\')\n        .select(\'*\')\n        .eq(\'user_id\', userId)\n        .maybeSingle();\n\n      if (data && !error) {\n        const farmer: HouseholdProfile = {\n          id: userId,\n          farmerName: data.farmer_name || \'Farmer\',\n          householdSize: data.household_size || 5,\n          ageGroups: data.age_groups || { children0_5: 1, children6_12: 1, teens13_18: 0, adults19_59: 2, seniors60Plus: 1 },\n          dietPreference: data.diet_preference || \'VEGETARIAN\',\n        };\n\n        const farm: FarmProfile = {\n          id: `farm_${userId}`,\n          farmerId: userId,\n          farmName: `${data.farmer_name || \'Farmer\'}\'s Field`,\n          state: data.state || \'Haryana\',\n          district: data.district || \'Karnal\',\n          latitude: 29.6857,\n          longitude: 76.9905,\n          landAreaAcres: data.land_area_acres || 2.5,\n          waterSource: data.water_source || \'IRRIGATED_BOREWELL\',\n          budgetInr: data.budget_inr || 25000,\n          cropHistory: data.crop_history || [\'Wheat\', \'Rice\'],\n          soil: {\n            type: data.soil_type || \'Alluvial Loam\',\n            pH: data.soil_ph || 7.2,\n            nitrogenKgHa: data.soil_nitrogen || 140,\n            phosphorusKgHa: data.soil_phosphorus || 28,\n            potassiumKgHa: 195,\n            organicCarbonPercent: 0.65,\n          },\n        };\n\n        return { farmer, farm, hasCompleted: true };\n      }\n    } catch (err) {\n      console.warn(\'Note on fetching Supabase onboarding profile:\', err);\n    }\n\n    return {\n      farmer: localData?.farmer || null,\n      farm: localData?.farm || null,\n      hasCompleted: Boolean(localData?.farmer && localData?.farm),\n    };\n  }"
    }
