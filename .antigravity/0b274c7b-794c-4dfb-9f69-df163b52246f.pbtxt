          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const scores = [proteinCov, ironCov, calciumCov, vitACov, vitCCov, fiberCov, calCov];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const overallScore = Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);"
