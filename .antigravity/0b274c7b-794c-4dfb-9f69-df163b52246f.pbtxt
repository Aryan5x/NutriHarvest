    instruction: "Add Refresh button to ExecutiveDashboard header banner"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { CandidateCrop, HarvestAllocation, ModelMetrics, NutritionCoverageScore, PriceForecast, WeatherObservation, WeatherAlert, HouseholdProfile, FarmProfile } from \'../types\';\nimport { Sprout, Heart, Store, Scale, Cpu, CloudRain, ShieldCheck, ArrowRight, DollarSign, Sparkles } from \'lucide-react\';\n\ninterface ExecutiveDashboardProps {\n  farmer: HouseholdProfile;\n  farm: FarmProfile;\n  coverage: NutritionCoverageScore;\n  candidates: CandidateCrop[];\n  weather: WeatherObservation;\n  alerts: WeatherAlert[];\n  forecast: PriceForecast;\n  allocation: HarvestAllocation;\n  metrics: ModelMetrics;\n  onNavigateTab: (tab: string) => void;\n}\n\nexport const ExecutiveDashboard: React.FC<ExecutiveDashboardProps> = ({\n  farmer,\n  farm,\n  coverage,\n  candidates,\n  weather,\n  alerts,\n  forecast,\n  allocation,\n  metrics,\n  onNavigateTab,\n}) => {"
        replacement_content: "import React, { useState } from \'react\';\nimport { CandidateCrop, HarvestAllocation, ModelMetrics, NutritionCoverageScore, PriceForecast, WeatherObservation, WeatherAlert, HouseholdProfile, FarmProfile } from \'../types\';\nimport { Sprout, Heart, Store, Scale, Cpu, CloudRain, ShieldCheck, ArrowRight, DollarSign, Sparkles, RefreshCw } from \'lucide-react\';\n\ninterface ExecutiveDashboardProps {\n  farmer: HouseholdProfile;\n  farm: FarmProfile;\n  coverage: NutritionCoverageScore;\n  candidates: CandidateCrop[];\n  weather: WeatherObservation;\n  alerts: WeatherAlert[];\n  forecast: PriceForecast;\n  allocation: HarvestAllocation;\n  metrics: ModelMetrics;\n  onNavigateTab: (tab: string) => void;\n  onRefresh?: () => void;\n}\n\nexport const ExecutiveDashboard: React.FC<ExecutiveDashboardProps> = ({\n  farmer,\n  farm,\n  coverage,\n  candidates,\n  weather,\n  alerts,\n  forecast,\n  allocation,\n  metrics,\n  onNavigateTab,\n  onRefresh,\n}) => {\n  const [isRefreshing, setIsRefreshing] = useState(false);\n  const [lastRefreshedAt, setLastRefreshedAt] = useState<string>(new Date().toLocaleTimeString());\n\n  const handleRefreshClick = async () => {\n    setIsRefreshing(true);\n    setLastRefreshedAt(new Date().toLocaleTimeString());\n    if (onRefresh) {\n      await onRefresh();\n    }\n    setTimeout(() => setIsRefreshing(false), 500);\n  };"
      }
      num_matches: 1
    }
  }
}
