  file_change {
    absolute_path_uri: "file:///src/components/CropPlanCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { CandidateCrop, ModelMetrics } from \'../types\';\nimport { Cpu, RefreshCw, CheckCircle2, Database, AlertCircle, TrendingUp, Info } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface CropPlanCardProps {\n  candidates: CandidateCrop[];\n  metrics: ModelMetrics;\n  onRefresh?: () => void;\n}\n\nexport const CropPlanCard: React.FC<CropPlanCardProps> = ({ candidates, metrics, onRefresh }) => {\n  const [isRefreshing, setIsRefreshing] = useState(false);\n  const [showDetails, setShowDetails] = useState(false);\n  const [lastRefreshedAt, setLastRefreshedAt] = useState<string>(new Date().toLocaleTimeString());\n\n  const handleRefreshClick = async () => {\n    setIsRefreshing(true);\n    setLastRefreshedAt(new Date().toLocaleTimeString());\n    if (onRefresh) {\n      await onRefresh();\n    }\n    setTimeout(() => setIsRefreshing(false), 500);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header & XGBoost Model Transparency Banner */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-5\">\n        <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <Cpu className=\"w-5 h-5 text-[#4A6741]\" />\n              <h2 className=\"text-2xl font-serif italic text-[#4A6741]\">User-Specific Crop Recommendations & Yield ML</h2>\n            </div>\n            <p className=\"text-xs text-[#6B6E6B] mt-1\">\n              Every prediction is computed by a real XGBoost / Gradient Boosted ML model trained on historical Indian agricultural field census records (1997\342\200\2232020).\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <button\n              onClick={handleRefreshClick}\n              disabled={isRefreshing}\n              className=\"flex items-center space-x-1.5 bg-[#F2F8F0] hover:bg-[#E3EFE0] text-[#4A6741] border border-[#4A6741]/30 text-xs px-3 py-1.5 rounded-lg font-bold transition-all cursor-pointer\"\n              title={`Last updated: ${lastRefreshedAt}`}\n            >\n              <RefreshCw className={`w-3.5 h-3.5 text-[#4A6741] ${isRefreshing ? \'animate-spin\' : \'\'}`} />\n              <span>{isRefreshing ? \'Re-running Models...\' : \'Refresh Recommendations\'}</span>\n            </button>\n            <DataBadge type=\"ML_MODEL\" label={metrics.modelName || \'XGBoost Regressor\'} />\n            <DataBadge type=\"DATASET\" label=\"Real Indian Ag Dataset (1997-2020)\" />\n          </div>\n        </div>\n\n        {/* Real Model Metrics & Provenance Card */}\n        <div className=\"bg-[#4A6741] text-white p-5 rounded-xl border border-[#3A5033] space-y-4\">\n          <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs border-b border-white/20 pb-3\">\n            <div className=\"flex items-center space-x-2\">\n              <Database className=\"w-4 h-4 text-[#D4A373]\" />\n              <span className=\"font-bold text-white\">Dataset: {metrics.trainingDataset}</span>\n              <span className=\"text-white/70\">({metrics.trainingPeriod} Train / {metrics.testPeriod} Held-Out Test)</span>\n            </div>\n            <button\n              onClick={() => setShowDetails(!showDetails)}\n              className=\"text-[#D4A373] hover:text-white underline font-medium text-xs flex items-center space-x-1 cursor-pointer\"\n            >\n              <Info className=\"w-3.5 h-3.5\" />\n              <span>{showDetails ? \'Hide Model Benchmarks\' : \'View Baseline Comparison & Per-Crop Metrics\'}</span>\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-4 text-xs\">\n            <div>\n              <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">Model MAE</span>\n              <span className=\"text-lg font-mono font-bold text-white\">\302\261{metrics.mae} kg/ha</span>\n            </div>\n            <div>\n              <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">Model RMSE</span>\n              <span className=\"text-lg font-mono font-bold text-white\">{metrics.rmse} kg/ha</span>\n            </div>\n            <div>\n              <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">Model R\302\262 Score</span>\n              <span className=\"text-lg font-mono font-bold text-[#D4A373]\">{metrics.r2Score} / 1.0</span>\n            </div>\n            <div>\n              <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">Training Samples</span>\n              <span className=\"text-lg font-mono font-bold text-white\">{metrics.trainingSamples} rows</span>\n            </div>\n            <div>\n              <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">Held-Out Test Set</span>\n              <span className=\"text-lg font-mono font-bold text-white\">{metrics.testSamples} samples</span>\n            </div>\n          </div>\n\n          {/* Expandable Baseline & Per-Crop Breakdown Panel */}\n          {showDetails && (\n            <div className=\"pt-4 border-t border-white/20 text-xs space-y-4\">\n              <div className=\"bg-[#3A5033] p-3 rounded-lg space-y-2\">\n                <span className=\"font-bold text-[#D4A373] uppercase tracking-wider block text-[11px]\">\n                  Model Baseline Benchmarks (2017\342\200\2232020 Held-Out Test Evaluation)\n                </span>\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3 font-mono text-[11px]\">\n                  <div className=\"bg-black/20 p-2.5 rounded border border-white/10\">\n                    <span className=\"text-white/80 font-sans font-bold block\">Trained XGBoost Model:</span>\n                    <span>R\302\262 = {metrics.r2Score} | MAE = {metrics.mae} kg/ha | RMSE = {metrics.rmse} kg/ha</span>\n                  </div>\n                  <div className=\"bg-black/20 p-2.5 rounded border border-white/10\">\n                    <span className=\"text-white/80 font-sans font-bold block\">Baseline A (Global Training Mean):</span>\n                    <span>R\302\262 = {metrics.baselineGlobalMean?.r2Score || 0} | MAE = {metrics.baselineGlobalMean?.mae || 0} kg/ha</span>\n                  </div>\n                  <div className=\"bg-black/20 p-2.5 rounded border border-white/10\">\n                    <span className=\"text-white/80 font-sans font-bold block\">Baseline B (Crop Historical Mean):</span>\n                    <span>R\302\262 = {metrics.baselineCropMean?.r2Score || 0} | MAE = {metrics.baselineCropMean?.mae || 0} kg/ha</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Per-Crop Test Breakdown */}\n              {metrics.perCropPerformance && metrics.perCropPerformance.length > 0 && (\n                <div className=\"bg-[#3A5033] p-3 rounded-lg space-y-2\">\n                  <span className=\"font-bold text-[#D4A373] uppercase tracking-wider block text-[11px]\">\n                    Per-Crop Held-Out Test Performance (2017\342\200\2232020)\n                  </span>\n                  <div className=\"overflow-x-auto\">\n                    <table className=\"w-full text-left font-mono text-[11px] border-collapse\">\n                      <thead>\n                        <tr className=\"border-b border-white/20 text-white/70\">\n                          <th className=\"py-1 px-2\">Crop</th>\n                          <th className=\"py-1 px-2\">Test Samples</th>\n                          <th className=\"py-1 px-2\">R\302\262 Score</th>\n                          <th className=\"py-1 px-2\">MAE (kg/ha)</th>\n                          <th className=\"py-1 px-2\">RMSE (kg/ha)</th>\n                        </tr>\n                      </thead>\n                      <tbody>\n                        {metrics.perCropPerformance.map((item, idx) => (\n                          <tr key={idx} className=\"border-b border-white/10 hover:bg-white/5\">\n                            <td className=\"py-1 px-2 font-sans font-semibold text-white\">{item.crop}</td>\n                            <td className=\"py-1 px-2\">{item.samples}</td>\n                            <td className=\"py-1 px-2 text-[#D4A373] font-bold\">{item.r2Score}</td>\n                            <td className=\"py-1 px-2\">{item.mae}</td>\n                            <td className=\"py-1 px-2\">{item.rmse}</td>\n                          </tr>\n                        ))}\n                      </tbody>\n                    </table>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Recommended Crop Portfolio */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-6\">\n        <div className=\"flex items-center justify-between border-b border-[#EBE7DF] pb-3\">\n          <div>\n            <h3 className=\"font-bold text-[#2D302D] text-sm uppercase tracking-wider\">\n              Recommended Crop Portfolio for Your Farm\n            </h3>\n            <p className=\"text-xs text-[#6B6E6B]\">\n              Ranked and evaluated against your profile inputs. Predictions derive from the trained ML yield pipeline.\n            </p>\n          </div>\n          <DataBadge type=\"CALCULATED\" label=\"Agronomic & ML Engine\" />\n        </div>\n\n        <div className=\"grid grid-cols-1 gap-6\">\n          {(candidates || []).map((c, index) => (\n            <div\n              key={c.id}\n              className=\"p-5 rounded-xl border border-[#EBE7DF] bg-[#FAF8F5] hover:border-[#4A6741]/40 transition-all space-y-4\"\n            >\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#EBE7DF] pb-3\">\n                <div className=\"flex items-center space-x-3\">\n                  <span className=\"w-7 h-7 rounded-full bg-[#4A6741] text-white flex items-center justify-center text-xs font-bold font-mono\">\n                    #{index + 1}\n                  </span>\n                  <div>\n                    <h4 className=\"text-lg font-bold text-[#2D302D] flex items-center space-x-2\">\n                      <span>{c.name}</span>\n                      <span className=\"text-xs px-2 py-0.5 rounded-full bg-[#EBE7DF] text-[#6B6E6B] font-normal\">\n                        {c.category} \342\200\242 {c.season}\n                      </span>\n                    </h4>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center space-x-3 text-xs\">\n                  <div className=\"text-right\">\n                    <span className=\"text-[#6B6E6B] block text-[11px]\">Recommended Acreage</span>\n                    <span className=\"font-bold text-[#2D302D]\">{c.recommendedAcreage} acres</span>\n                  </div>\n                  <div className=\"text-right pl-3 border-l border-[#EBE7DF]\">\n                    <span className=\"text-[#6B6E6B] block text-[11px]\">Predicted Harvest</span>\n                    <span className=\"font-bold text-[#4A6741] font-mono\">{c.totalExpectedYieldKg} kg</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Yield Prediction Metrics */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 bg-white p-3 rounded-lg border border-[#EBE7DF] text-xs\">\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">ML Predicted Yield</span>\n                  <span className=\"font-mono font-bold text-[#2D302D]\">{c.predictedYieldKgPerAcre} kg/acre</span>\n                </div>\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">Prediction Mode</span>\n                  <span className=\"font-mono text-[#4A6741] font-bold\">{c.predictionModeLabel || \'Pre-season ML Yield Estimate\'}</span>\n                </div>\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">Historical Model Error</span>\n                  <span className=\"font-mono text-[#6B6E6B]\">\302\261{metrics.mae} kg/ha (MAE)</span>\n                </div>\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">Est. Production Cost</span>\n                  <span className=\"font-mono text-[#2D302D]\">\342\202\271{Math.round(c.costPerAcreInr * c.recommendedAcreage).toLocaleString()}</span>\n                </div>\n              </div>\n\n              {/* Itemized Reasons WHY crop was recommended */}\n              <div className=\"space-y-2\">\n                <span className=\"text-xs font-bold text-[#4A6741] uppercase tracking-wider flex items-center space-x-1\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#4A6741]\" />\n                  <span>Why this crop is recommended for your farm:</span>\n                </span>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n                  {c.recommendationReasons?.map((reason, rIdx) => (\n                    <div key={rIdx} className=\"flex items-start space-x-2 bg-emerald-50/60 p-2 rounded border border-emerald-100\">\n                      <span className=\"text-emerald-800 font-medium\">{reason}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
