          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function getCropNutritionInfo(cropKey: string): CropNutritionInfo | null {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (!cropKey) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const upperKey = cropKey.toUpperCase().trim();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Direct key match"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (IFCT2017_CROP_NUTRITION[upperKey]) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return IFCT2017_CROP_NUTRITION[upperKey];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Synonym & substring match"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const clean = cropKey.toLowerCase().trim();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'wheat\')) return IFCT2017_CROP_NUTRITION.WHEAT;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'rice\') || clean.includes(\'paddy\')) return IFCT2017_CROP_NUTRITION.RICE;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'bajra\') || clean.includes(\'pearl millet\')) return IFCT2017_CROP_NUTRITION.BAJRA;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'jowar\') || clean.includes(\'sorghum\')) return IFCT2017_CROP_NUTRITION.JOWAR;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'maize\') || clean.includes(\'corn\')) return IFCT2017_CROP_NUTRITION.MAIZE;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'chickpea\') || clean.includes(\'chana\') || clean.includes(\'bengal gram\')) return IFCT2017_CROP_NUTRITION.CHICKPEA;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'pigeon\') || clean.includes(\'tur\') || clean.includes(\'arhar\') || clean.includes(\'red gram\')) return IFCT2017_CROP_NUTRITION.PIGEON_PEA;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'lentil\') || clean.includes(\'masoor\')) return IFCT2017_CROP_NUTRITION.LENTIL;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'moong\') || clean.includes(\'green gram\')) return IFCT2017_CROP_NUTRITION.MOONG_BEAN;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'groundnut\') || clean.includes(\'peanut\')) return IFCT2017_CROP_NUTRITION.GROUNDNUT;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'mustard\')) return IFCT2017_CROP_NUTRITION.MUSTARD;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'potato\')) return IFCT2017_CROP_NUTRITION.POTATO;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'tomato\')) return IFCT2017_CROP_NUTRITION.TOMATO;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'onion\')) return IFCT2017_CROP_NUTRITION.ONION;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'spinach\') || clean.includes(\'palak\')) return IFCT2017_CROP_NUTRITION.SPINACH;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'okra\') || clean.includes(\'bhindi\') || clean.includes(\'lady finger\')) return IFCT2017_CROP_NUTRITION.OKRA;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (clean.includes(\'brinjal\') || clean.includes(\'eggplant\') || clean.includes(\'baingan\')) return IFCT2017_CROP_NUTRITION.BRINJAL;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  for (const info of Object.values(IFCT2017_CROP_NUTRITION)) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (info.cropName.toLowerCase().includes(clean) || clean.includes(info.cropId.toLowerCase())) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return info;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
