assName={`text-[10px] px-2.5 py-0.5 rounded-full font-bold ${\n                  src.status === \'LIVE_CONNECTED\'\n                    ? \'bg-emerald-100 text-emerald-800 border border-emerald-300\'\n                    : \'bg-amber-100 text-amber-800 border border-amber-300\'\n                }`}\n              >\n                {src.status}\n              </span>\n            </div>\n\n            <p className=\"text-xs text-slate-600 leading-relaxed\">{src.description}</p>\n\n            <div className=\"pt-2 border-t border-slate-100 text-[11px] text-slate-500 space-y-1\">\n              <div>\n                <span className=\"font-semibold text-slate-700\">Provider:</span> {src.provider}\n              </div>\n              <div>\n                <span className=\"font-semibold text-slate-700\">License:</span> {src.license}\n              </div>\n              <div className=\"flex items-center justify-between pt-1\">\n                <span>Retrieved: {src.retrievedAt}</span>\n                <a\n                  href={src.sourceUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"text-emerald-600 hover:text-emerald-700 font-semibold flex items-center space-x-1\"\n                >\n                  <span>Verify Source</span>\n                  <ExternalLink className=\"w-3 h-3\" />\n                </a>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
