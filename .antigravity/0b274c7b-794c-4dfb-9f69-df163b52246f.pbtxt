        lines {
          text: "  private static normalizeCropName(cropName: string): string {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const name = (cropName || \'\').toLowerCase().trim();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'wheat\')) return \'wheat\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'rice\') || name.includes(\'paddy\')) return \'paddy / rice\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'chana\') || name.includes(\'chickpea\')) return \'chickpea (chana)\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'mustard\')) return \'mustard\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'bajra\') || name.includes(\'millet\')) return \'pearl millet (bajra)\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'tomato\')) return \'tomato\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'potato\')) return \'potato\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'onion\')) return \'onion\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'maize\') || name.includes(\'corn\')) return \'maize\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'moong\')) return \'moong dal\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'palak\') || name.includes(\'spinach\')) return \'spinach (palak)\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (name.includes(\'okra\') || name.includes(\'bhindi\')) return \'okra\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return name;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
