    replacement_infos {
      original_chunk {
        target_content: "/**\n * NutriHarvest AI Data Provenance Registry\n */\n\nimport { DataProvenanceItem } from \'../types\';\n\nexport const PROVENANCE_REGISTRY: DataProvenanceItem[] = [\n  {\n    id: \'DS_IFCT2017\',\n    name: \'Indian Food Composition Tables (IFCT 2017)\',\n    provider: \'ICMR - National Institute of Nutrition (NIN), Hyderabad\',\n    sourceUrl: \'https://www.nin.res.in/ebooks/IFCT2017_16122024.pdf\',\n    retrievedAt: \'2026-08-10\',\n    license: \'ICMR-NIN Educational & Research License\',\n    description: \'Authoritative chemical composition & nutritional database for Indian food items across 7 key macronutrients & micronutrients.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_AGMARKNET\',\n    name: \'Daily Wholesale Mandi Market Prices\',\n    provider: \'Government of India Data.gov.in / AGMARKNET\',\n    sourceUrl: \'https://www.data.gov.in/catalog/current-daily-price-various-commodities-various-markets-mandi\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Open Government Data License (OGDL) India\',\n    description: \'Official wholesale commodity price feed (Modal, Min, Max prices) across APMC mandis in Indian districts.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_OPEN_METEO\',\n    name: \'Hyperlocal Weather & Climate Forecast API\',\n    provider: \'Open-Meteo Weather API\',\n    sourceUrl: \'https://open-meteo.com/en/docs\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Non-commercial Attribution (CC BY 4.0)\',\n    description: \'High-resolution hourly weather forecasts, rainfall probabilities, evapotranspiration (ET0), and heat index alerts.\',\n    status: \'LIVE_CONNECTED\',\n  },\n  {\n    id: \'DS_SOILGRIDS\',\n    name: \'ISRIC SoilGrids REST API v2.0\',\n    provider: \'ISRIC - World Soil Information\',\n    sourceUrl: \'https://rest.isric.org/soilgrids/v2.0/docs\',\n    retrievedAt: \'2026-08-10\',\n    license: \'CC BY 4.0 International\',\n    description: \'Global 250m spatial resolution soil property predictions (pH, organic carbon, clay/sand/silt content, bulk density).\',\n    status: \'LIVE_CONNECTED\',\n  },\n  {\n    id: \'DS_CROP_YIELD\',\n    name: \'Agricultural Crop Yield in Indian States Dataset (1997-2020)\',\n    provider: \'Ministry of Agriculture & Farmers Welfare / Kaggle Open Data\',\n    sourceUrl: \'https://www.kaggle.com/datasets/akshatgupta7/crop-yield-in-indian-states-dataset\',\n    retrievedAt: \'2026-08-09\',\n    license: \'Database Contents License (DbCL)\',\n    description: \'Historical crop yield dataset for training the XGBoost yield predictor with 12 features excluding Production to prevent target leakage.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n];"
        replacement_content: "/**\n * NutriHarvest AI Data Provenance Registry\n */\n\nimport { DataProvenanceItem } from \'../types\';\n\nexport const PROVENANCE_REGISTRY: DataProvenanceItem[] = [\n  {\n    id: \'DS_IFCT2017\',\n    name: \'Indian Food Composition Tables (IFCT 2017)\',\n    provider: \'ICMR - National Institute of Nutrition (NIN), Hyderabad\',\n    sourceUrl: \'https://www.nin.res.in/ebooks/IFCT2017_16122024.pdf\',\n    retrievedAt: \'2026-08-11\',\n    license: \'ICMR-NIN Educational & Research License\',\n    description: \'Primary/preferred authoritative nutrition composition source for Indian food items across key macronutrients & micronutrients.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_IFCT2017_REPO\',\n    name: \'IFCT 2017 Open-Source Structured Repository\',\n    provider: \'IFCT 2017 Open-Source Community\',\n    sourceUrl: \'https://github.com/ifct2017/ifct2017\',\n    retrievedAt: \'2026-08-11\',\n    license: \'MIT / Open Attribution\',\n    description: \'Structured database derived from IFCT 2017 ICMR tables for digital lookup and nutritional deficit calculation.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_AGMARKNET\',\n    name: \'Current Daily Mandi Price Feed\',\n    provider: \'Government of India Data.gov.in / AGMARKNET\',\n    sourceUrl: \'https://www.data.gov.in/catalog/current-daily-price-various-commodities-various-markets-mandi\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Open Government Data License (OGDL) India\',\n    description: \'Official wholesale commodity price feed (Modal, Min, Max prices) across APMC mandis in Indian districts.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_MANDI_HISTORICAL\',\n    name: \'Daily Wholesale Commodity Prices \342\200\224 India Mandis\',\n    provider: \'AGMARKNET / Kaggle Open Data (Ishan Kataria)\',\n    sourceUrl: \'https://www.kaggle.com/datasets/ishankat/daily-wholesale-commodity-prices-india-mandis\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Database Contents License (DbCL)\',\n    description: \'Historical mandi price time-series dataset for trend analysis and price stability metrics.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_OPEN_METEO\',\n    name: \'Hyperlocal Weather & Climate Forecast API\',\n    provider: \'Open-Meteo Weather API\',\n    sourceUrl: \'https://open-meteo.com/en/docs\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Non-commercial Attribution (CC BY 4.0)\',\n    description: \'High-resolution hourly weather forecasts, rainfall probabilities, evapotranspiration (ET0), and heat index alerts.\',\n    status: \'LIVE_CONNECTED\',\n  },\n  {\n    id: \'DS_SOILGRIDS\',\n    name: \'ISRIC SoilGrids REST API v2.0\',\n    provider: \'ISRIC - World Soil Information\',\n    sourceUrl: \'https://rest.isric.org/soilgrids/v2.0/docs\',\n    retrievedAt: \'2026-08-11\',\n    license: \'CC BY 4.0 International\',\n    description: \'Global 250m spatial resolution soil property predictions (pH, organic carbon, clay/sand/silt content).\',\n    status: \'LIVE_CONNECTED\',\n  },\n  {\n    id: \'DS_CROP_YIELD\',\n    name: \'Agricultural Crop Yield in Indian States Dataset (1997-2020)\',\n    provider: \'Ministry of Agriculture & Farmers Welfare / Kaggle Open Data (Akshat Gupta)\',\n    sourceUrl: \'https://www.kaggle.com/datasets/akshatgupta7/crop-yield-in-indian-states-dataset\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Database Contents License (DbCL)\',\n    description: \'Historical crop yield dataset for training the XGBoost yield predictor with features excluding Production to prevent target leakage.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_CROP_YIELD_SOIL_WEATHER\',\n    name: \'Crop Yield Data with Soil and Weather Dataset\',\n    provider: \'Kaggle Open Data (Anshu Mishra)\',\n    sourceUrl: \'https://www.kaggle.com/datasets/anshumish/crop-yield-data-with-soil-and-weather-dataset\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Database Contents License (DbCL)\',\n    description: \'Combined dataset featuring crop yield, soil N/P/K, soil pH, temperature, rainfall, fertilizer, and pesticide.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_CROP_REC\',\n    name: \'Crop Recommendation Dataset\',\n    provider: \'Kaggle Open Data (Siddharth Sharma)\',\n    sourceUrl: \'https://www.kaggle.com/datasets/siddharthss/crop-recommendation-dataset\',\n    retrievedAt: \'2026-08-11\',\n    license: \'CC0 Public Domain\',\n    description: \'N, P, K, temperature, humidity, pH, and rainfall features for agricultural crop adaptability verification.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n  {\n    id: \'DS_FARMER_IN\',\n    name: \'Farmer.in \342\200\224 Indian Agriculture Datasets\',\n    provider: \'Government of India Agriculture Portal\',\n    sourceUrl: \'https://www.farmer.in/datasets/\',\n    retrievedAt: \'2026-08-11\',\n    license: \'Open Government Data\',\n    description: \'MSP rates, APMC mandi directory, and modal price reference dataset.\',\n    status: \'VERIFIED_SNAPSHOT\',\n  },\n];\n"
