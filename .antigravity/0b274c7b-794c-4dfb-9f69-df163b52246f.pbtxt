          text: "    // Target Encodings strictly from training set"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const cropMean = this.cropTrainingMeans.get(cNorm) || this.trainingGlobalMean;"
