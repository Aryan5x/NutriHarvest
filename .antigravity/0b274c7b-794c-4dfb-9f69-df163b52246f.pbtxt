        }
        lines {
          text: "      // Model formula representing agricultural response function"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const phFactor = Math.max(0.7, 1 - Math.abs(ph - crop.phOpt) * 0.2);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const rainFactor = Math.max(0.75, 1 - Math.abs(rain - crop.rainOpt) / (crop.rainOpt || 500));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const fertFactor = Math.min(1.25, 0.85 + (fert / 180) * 0.3);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const noise = (pseudoRandom() - 0.5) * crop.stdYield * 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const yieldVal = Math.round("
