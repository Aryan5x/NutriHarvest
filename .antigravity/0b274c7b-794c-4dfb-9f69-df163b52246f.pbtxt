    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { FarmProfile, HouseholdProfile } from \'../types\';\nimport { Users, MapPin, Droplets, Landmark, Layers, Sparkles } from \'lucide-react\';\n\ninterface FarmerProfileWizardProps {\n  farmer: HouseholdProfile;\n  setFarmer: React.Dispatch<React.SetStateAction<HouseholdProfile>>;\n  farm: FarmProfile;\n  setFarm: React.Dispatch<React.SetStateAction<FarmProfile>>;\n  onSaveAndGenerate: () => void;\n}\n\nexport const FarmerProfileWizard: React.FC<FarmerProfileWizardProps> = ({\n  farmer,\n  setFarmer,\n  farm,\n  setFarm,\n  onSaveAndGenerate,\n}) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900\">Farmer & Household Profile</h2>\n          <p className=\"text-sm text-slate-500 mt-0.5\">\n            Step 1 & 2: Define family dietary requirements, land size, soil characteristics, and farm location.\n          </p>\n        </div>\n        <button\n          onClick={onSaveAndGenerate}\n          className=\"bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl font-medium text-sm flex items-center space-x-2 shadow-md shadow-emerald-700/20 transition-all\"\n        >\n          <Sparkles className=\"w-4 h-4 text-emerald-100\" />\n          <span>Save Profile & Generate AI Plan</span>\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Household Nutrition Requirements Form */}\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5\">\n          <div className=\"flex items-center space-x-2 border-b border-slate-100 pb-3\">\n            <Users className=\"w-5 h-5 text-emerald-600\" />\n            <h3 className=\"font-semibold text-slate-900\">1. Household Demographics & Diet</h3>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Farmer Full Name</label>\n              <input\n                type=\"text\"\n                value={farmer.farmerName}\n                onChange={(e) => setFarmer({ ...farmer, farmerName: e.target.value })}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Dietary Preference</label>\n              <select\n                value={farmer.dietPreference}\n                onChange={(e) => setFarmer({ ...farmer, dietPreference: e.target.value as any })}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white\"\n              >\n                <option value=\"VEGETARIAN\">Vegetarian (Lacto-Vegetarian)</option>\n                <option value=\"NON_VEGETARIAN\">Non-Vegetarian</option>\n                <option value=\"EGGETARIAN\">Eggetarian</option>\n                <option value=\"VEGAN\">Vegan</option>\n              </select>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 mb-2\">Household Age Groups (Total: {farmer.householdSize} members)</label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200\">\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Children (0-5 yrs)</span>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  max=\"10\"\n                  value={farmer.ageGroups.children0_5}\n                  onChange={(e) => {\n                    const val = Number(e.target.value);\n                    const newGroups = { ...farmer.ageGroups, children0_5: val };\n                    const total = Object.values(newGroups).reduce((a, b) => a + b, 0);\n                    setFarmer({ ...farmer, ageGroups: newGroups, householdSize: total });\n                  }}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Children (6-12 yrs)</span>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  max=\"10\"\n                  value={farmer.ageGroups.children6_12}\n                  onChange={(e) => {\n                    const val = Number(e.target.value);\n                    const newGroups = { ...farmer.ageGroups, children6_12: val };\n                    const total = Object.values(newGroups).reduce((a, b) => a + b, 0);\n                    setFarmer({ ...farmer, ageGroups: newGroups, householdSize: total });\n                  }}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Teens (13-18 yrs)</span>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  max=\"10\"\n                  value={farmer.ageGroups.teens13_18}\n                  onChange={(e) => {\n                    const val = Number(e.target.value);\n                    const newGroups = { ...farmer.ageGroups, teens13_18: val };\n                    const total = Object.values(newGroups).reduce((a, b) => a + b, 0);\n                    setFarmer({ ...farmer, ageGroups: newGroups, householdSize: total });\n                  }}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Adults (19-59 yrs)</span>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  max=\"10\"\n                  value={farmer.ageGroups.adults19_59}\n                  onChange={(e) => {\n                    const val = Number(e.target.value);\n                    const newGroups = { ...farmer.ageGroups, adults19_59: val };\n                    const total = Object.values(newGroups).reduce((a, b) => a + b, 0);\n                    setFarmer({ ...farmer, ageGroups: newGroups, householdSize: total });\n                  }}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Seniors (60+ yrs)</span>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  max=\"10\"\n                  value={farmer.ageGroups.seniors60Plus}\n                  onChange={(e) => {\n                    const val = Number(e.target.value);\n                    const newGroups = { ...farmer.ageGroups, seniors60Plus: val };\n                    const total = Object.values(newGroups).reduce((a, b) => a + b, 0);\n                    setFarmer({ ...farmer, ageGroups: newGroups, householdSize: total });\n                  }}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Farm Characteristics & Geography Form */}\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5\">\n          <div className=\"flex items-center space-x-2 border-b border-slate-100 pb-3\">\n            <Layers className=\"w-5 h-5 text-emerald-600\" />\n            <h3 className=\"font-semibold text-slate-900\">2. Farm Land, Location & Soil</h3>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">State</label>\n              <select\n                value={farm.state}\n                onChange={(e) => setFarm({ ...farm, state: e.target.value })}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white\"\n              >\n                <option value=\"Haryana\">Haryana</option>\n                <option value=\"Maharashtra\">Maharashtra</option>\n                <option value=\"Punjab\">Punjab</option>\n                <option value=\"Bihar\">Bihar</option>\n                <option value=\"Rajasthan\">Rajasthan</option>\n                <option value=\"Uttar Pradesh\">Uttar Pradesh</option>\n                <option value=\"Madhya Pradesh\">Madhya Pradesh</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">District</label>\n              <input\n                type=\"text\"\n                value={farm.district}\n                onChange={(e) => setFarm({ ...farm, district: e.target.value })}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Land Area (Acres)</label>\n              <input\n                type=\"number\"\n                step=\"0.1\"\n                min=\"0.5\"\n                max=\"50\"\n                value={farm.landAreaAcres}\n                onChange={(e) => setFarm({ ...farm, landAreaAcres: Number(e.target.value) })}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Water Source</label>\n              <select\n                value={farm.waterSource}\n                onChange={(e) => setFarm({ ...farm, waterSource: e.target.value as any })}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white\"\n              >\n                <option value=\"IRRIGATED_BOREWELL\">Borewell Irrigated</option>\n                <option value=\"IRRIGATED_CANAL\">Canal Irrigated</option>\n                <option value=\"RAINFED\">Rainfed Only</option>\n                <option value=\"DRIP_IRRIGATION\">Drip Micro-Irrigation</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Seasonal Budget (\342\202\271)</label>\n              <input\n                type=\"number\"\n                step=\"1000\"\n                value={farm.budgetInr}\n                onChange={(e) => setFarm({ ...farm, budgetInr: Number(e.target.value) })}\n                className=\"w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none\"\n              />\n            </div>\n          </div>\n\n          {/* Soil NPK & pH */}\n          <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3\">\n            <span className=\"text-xs font-semibold text-slate-800 block\">Soil Observation Parameters (SoilGrids / Testing)</span>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Soil Type</span>\n                <input\n                  type=\"text\"\n                  value={farm.soil.type}\n                  onChange={(e) => setFarm({ ...farm, soil: { ...farm.soil, type: e.target.value } })}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n              <div>\n                <span className=\"text-xs text-slate-500 block\">pH Level</span>\n                <input\n                  type=\"number\"\n                  step=\"0.1\"\n                  value={farm.soil.pH}\n                  onChange={(e) => setFarm({ ...farm, soil: { ...farm.soil, pH: Number(e.target.value) } })}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Nitrogen (N) kg/ha</span>\n                <input\n                  type=\"number\"\n                  value={farm.soil.nitrogenKgHa}\n                  onChange={(e) => setFarm({ ...farm, soil: { ...farm.soil, nitrogenKgHa: Number(e.target.value) } })}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n              <div>\n                <span className=\"text-xs text-slate-500 block\">Phosphorus (P) kg/ha</span>\n                <input\n                  type=\"number\"\n                  value={farm.soil.phosphorusKgHa}\n                  onChange={(e) => setFarm({ ...farm, soil: { ...farm.soil, phosphorusKgHa: Number(e.target.value) } })}\n                  className=\"w-full mt-1 px-2.5 py-1.5 border border-slate-300 rounded-lg text-sm bg-white\"\n                />\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
