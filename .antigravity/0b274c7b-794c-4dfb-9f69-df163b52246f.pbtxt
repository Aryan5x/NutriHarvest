        lines {
          text: "      if (!cropInfo || quantityKg <= 0) continue;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // 1 kg = 10 * 100g"
