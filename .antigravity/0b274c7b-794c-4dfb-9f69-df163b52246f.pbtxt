    instruction: "Add DataBadges and itemized recommendation reasons to CropPlanCard.tsx"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { CandidateCrop, ModelMetrics } from \'../types\';\nimport { Cpu, Calendar, CheckCircle, BarChart3, HelpCircle } from \'lucide-react\';\n\ninterface CropPlanCardProps {\n  candidates: CandidateCrop[];\n  metrics: ModelMetrics;\n}\n\nexport const CropPlanCard: React.FC<CropPlanCardProps> = ({ candidates, metrics }) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header & XGBoost Model Card Banner */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-4\">\n        <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <Cpu className=\"w-5 h-5 text-[#4A6741]\" />\n              <h2 className=\"text-2xl font-serif italic text-[#4A6741]\">AI Crop Planning & XGBoost Yield Predictions</h2>\n            </div>\n            <p className=\"text-xs text-[#6B6E6B] mt-1\">\n              Candidate crop selection & yield forecast trained on Agricultural Crop Yield in Indian States dataset (1997-2020).\n            </p>\n          </div>\n\n          <div className=\"bg-[#F2F8F0] px-3.5 py-2 rounded-xl border border-[#4A6741]/20 text-xs font-semibold text-[#4A6741] flex items-center space-x-2\">\n            <BarChart3 className=\"w-4 h-4 text-[#4A6741]\" />\n            <span>XGBoost Yield Regressor v2.1</span>\n          </div>\n        </div>\n\n        {/* Model Evaluation Metrics Card */}\n        <div className=\"bg-[#4A6741] text-white p-4 rounded-xl border border-[#3A5033] grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs\">\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">MAE (Error)</span>\n            <span className=\"text-lg font-mono font-bold text-white\">{metrics.mae} kg/ha</span>\n          </div>\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">RMSE (Error)</span>\n            <span className=\"text-lg font-mono font-bold text-white\">{metrics.rmse} kg/ha</span>\n          </div>\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">R\302\262 Test Score</span>\n            <span className=\"text-lg font-mono font-bold text-[#D4A373]\">{metrics.r2Score} / 1.0</span>\n          </div>\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">Test Split Size</span>\n            <span className=\"text-lg font-mono font-bold text-white\">{metrics.testSetSize} samples</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Candidate Crops Table */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-4\">\n        <h3 className=\"font-bold text-[#2D302D] text-xs uppercase tracking-wider border-b border-[#EBE7DF] pb-2\">\n          Recommended Crop Portfolio for Farm Acreage\n        </h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse text-xs\">\n            <thead>\n              <tr className=\"bg-[#F2EDE4] border-b border-[#D9D4C7] text-[#2D302D] font-bold\">\n                <th className=\"py-3 px-3\">Crop Name</th>\n                <th className=\"py-3 px-3\">Category</th>\n                <th className=\"py-3 px-3\">Season</th>\n                <th className=\"py-3 px-3\">Land Share</th>\n                <th className=\"py-3 px-3\">Predicted Yield (kg/acre)</th>\n                <th className=\"py-3 px-3\">Total Harvest (kg)</th>\n                <th className=\"py-3 px-3\">Est. Production Cost</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#EBE7DF]\">\n              {candidates.map((c) => (\n                <tr key={c.id} className=\"hover:bg-[#F2EDE4]/40 transition-all\">\n                  <td className=\"py-3 px-3 font-bold text-[#2D302D] flex items-center space-x-2\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#4A6741]\"></span>\n                    <span>{c.name}</span>\n                  </td>\n                  <td className=\"py-3 px-3 text-[#6B6E6B]\">{c.category}</td>\n                  <td className=\"py-3 px-3 font-semibold text-[#4A6741]\">{c.season}</td>\n                  <td className=\"py-3 px-3 font-bold text-[#2D302D]\">{c.recommendedAcreage} acres</td>\n                  <td className=\"py-3 px-3 text-[#2D302D] font-mono\">{c.predictedYieldKgPerAcre} kg</td>\n                  <td className=\"py-3 px-3 font-mono font-bold text-[#4A6741]\">{c.totalExpectedYieldKg} kg</td>\n                  <td className=\"py-3 px-3 text-[#6B6E6B] font-mono\">\342\202\271{Math.round(c.costPerAcreInr * c.recommendedAcreage)}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Planting Calendar Timeline */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-4\">\n        <div className=\"flex items-center space-x-2 border-b border-[#EBE7DF] pb-2\">\n          <Calendar className=\"w-5 h-5 text-[#4A6741]\" />\n          <h3 className=\"font-bold text-[#2D302D] text-xs uppercase tracking-wider\">Interactive Planting & Harvest Calendar</h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          <div className=\"p-4 rounded-xl bg-[#F2F8F0] border border-[#4A6741]/20 space-y-1\">\n            <span className=\"text-[11px] font-bold uppercase tracking-wider text-[#4A6741] block\">Stage 1: Land Prep & Sowing</span>\n            <span className=\"text-sm font-bold text-[#2D302D] block\">Weeks 1 - 2</span>\n            <p className=\"text-xs text-[#6B6E6B]\">Field tilling, FYM organic manure application, and seed treatment.</p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-[#FDF9F3] border border-[#D4A373]/30 space-y-1\">\n            <span className=\"text-[11px] font-bold uppercase tracking-wider text-[#8B5E34] block\">Stage 2: Crop Growth & Irrigation</span>\n            <span className=\"text-sm font-bold text-[#2D302D] block\">Weeks 3 - 12</span>\n            <p className=\"text-xs text-[#6B6E6B]\">Nutrient top-dressing, Open-Meteo guided irrigation scheduling, and weeding.</p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-[#F2EDE4] border border-[#D9D4C7] space-y-1\">\n            <span className=\"text-[11px] font-bold uppercase tracking-wider text-[#2D302D] block\">Stage 3: Harvest & Allocation</span>\n            <span className=\"text-sm font-bold text-[#2D302D] block\">Weeks 13 - 16</span>\n            <p className=\"text-xs text-[#6B6E6B]\">Threshing, grain drying, family nutrition reservation, and OR-Tools market sale.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { CandidateCrop, ModelMetrics } from \'../types\';\nimport { Cpu, Calendar, BarChart3, CheckCircle2, ShieldAlert } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface CropPlanCardProps {\n  candidates: CandidateCrop[];\n  metrics: ModelMetrics;\n}\n\nexport const CropPlanCard: React.FC<CropPlanCardProps> = ({ candidates, metrics }) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header & XGBoost Model Card Banner */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-4\">\n        <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <Cpu className=\"w-5 h-5 text-[#4A6741]\" />\n              <h2 className=\"text-2xl font-serif italic text-[#4A6741]\">User-Specific Crop Recommendations & Yield ML</h2>\n            </div>\n            <p className=\"text-xs text-[#6B6E6B] mt-1\">\n              Every recommendation is calculated using your actual farm acreage, soil characteristics, location, and household nutritional gaps.\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-2\">\n            <DataBadge type=\"ML_MODEL\" label={metrics.modelName} />\n            <DataBadge type=\"DATASET\" label=\"Kaggle Indian Ag Dataset\" />\n          </div>\n        </div>\n\n        {/* Model Evaluation Metrics Card */}\n        <div className=\"bg-[#4A6741] text-white p-4 rounded-xl border border-[#3A5033] grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs\">\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">MAE (Mean Abs Error)</span>\n            <span className=\"text-lg font-mono font-bold text-white\">{metrics.mae} kg/ha</span>\n          </div>\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">RMSE (Error)</span>\n            <span className=\"text-lg font-mono font-bold text-white\">{metrics.rmse} kg/ha</span>\n          </div>\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">R\302\262 Test Score</span>\n            <span className=\"text-lg font-mono font-bold text-[#D4A373]\">{metrics.r2Score} / 1.0</span>\n          </div>\n          <div>\n            <span className=\"text-white/80 block text-[11px] uppercase tracking-wider\">Validated On</span>\n            <span className=\"text-lg font-mono font-bold text-white\">{metrics.testSetSize} samples</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Recommended Crop Portfolio with Itemized Reasons */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-6\">\n        <div className=\"flex items-center justify-between border-b border-[#EBE7DF] pb-3\">\n          <div>\n            <h3 className=\"font-bold text-[#2D302D] text-sm uppercase tracking-wider\">\n              Recommended Crop Portfolio for Your Farm\n            </h3>\n            <p className=\"text-xs text-[#6B6E6B]\">\n              Ranked and evaluated against your profile inputs. Explanations derive from verified agronomic match rules.\n            </p>\n          </div>\n          <DataBadge type=\"CALCULATED\" label=\"Agronomic & ML Decision Engine\" />\n        </div>\n\n        <div className=\"grid grid-cols-1 gap-6\">\n          {candidates.map((c, index) => (\n            <div\n              key={c.id}\n              className=\"p-5 rounded-xl border border-[#EBE7DF] bg-[#FAF8F5] hover:border-[#4A6741]/40 transition-all space-y-4\"\n            >\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#EBE7DF] pb-3\">\n                <div className=\"flex items-center space-x-3\">\n                  <span className=\"w-7 h-7 rounded-full bg-[#4A6741] text-white flex items-center justify-center text-xs font-bold font-mono\">\n                    #{index + 1}\n                  </span>\n                  <div>\n                    <h4 className=\"text-lg font-bold text-[#2D302D] flex items-center space-x-2\">\n                      <span>{c.name}</span>\n                      <span className=\"text-xs px-2 py-0.5 rounded-full bg-[#EBE7DF] text-[#6B6E6B] font-normal\">\n                        {c.category} \342\200\242 {c.season}\n                      </span>\n                    </h4>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center space-x-3 text-xs\">\n                  <div className=\"text-right\">\n                    <span className=\"text-[#6B6E6B] block text-[11px]\">Recommended Acreage</span>\n                    <span className=\"font-bold text-[#2D302D]\">{c.recommendedAcreage} acres</span>\n                  </div>\n                  <div className=\"text-right pl-3 border-l border-[#EBE7DF]\">\n                    <span className=\"text-[#6B6E6B] block text-[11px]\">Predicted Harvest</span>\n                    <span className=\"font-bold text-[#4A6741] font-mono\">{c.totalExpectedYieldKg} kg</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Yield Prediction Metrics */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 bg-white p-3 rounded-lg border border-[#EBE7DF] text-xs\">\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">Yield per Acre</span>\n                  <span className=\"font-mono font-bold text-[#2D302D]\">{c.predictedYieldKgPerAcre} kg/acre</span>\n                </div>\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">Confidence Interval</span>\n                  <span className=\"font-mono text-[#2D302D]\">{c.yieldConfidenceInterval[0]} - {c.yieldConfidenceInterval[1]} kg</span>\n                </div>\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">Est. Production Cost</span>\n                  <span className=\"font-mono text-[#2D302D]\">\342\202\271{Math.round(c.costPerAcreInr * c.recommendedAcreage).toLocaleString()}</span>\n                </div>\n                <div>\n                  <span className=\"text-[#6B6E6B] block text-[11px]\">Growth Duration</span>\n                  <span className=\"font-mono text-[#2D302D]\">{c.durationDays} days</span>\n                </div>\n              </div>\n\n              {/* Itemized Reasons WHY crop was recommended */}\n              <div className=\"space-y-2\">\n                <span className=\"text-xs font-bold text-[#4A6741] uppercase tracking-wider flex items-center space-x-1\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#4A6741]\" />\n                  <span>Why this crop is recommended for your farm:</span>\n                </span>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n                  {c.recommendationReasons?.map((reason, rIdx) => (\n                    <div key={rIdx} className=\"flex items-start space-x-2 bg-emerald-50/60 dark:bg-emerald-950/20 p-2 rounded border border-emerald-100\">\n                      <span className=\"text-emerald-700 font-bold\">{reason}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
