    instruction: "Add Refresh button with spin animation and timestamp to ClimateWidget"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { WeatherAlert, WeatherObservation } from \'../types\';\nimport { CloudRain, Thermometer, Wind, Droplets, Sun, AlertTriangle, ShieldAlert, CheckCircle2, Info } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface ClimateWidgetProps {\n  weather: WeatherObservation;\n  alerts: WeatherAlert[];\n}\n\nexport const ClimateWidget: React.FC<ClimateWidgetProps> = ({ weather, alerts }) => {\n  const isDataLive = weather.source.includes(\'Open-Meteo\') || weather.source.includes(\'Live API\');"
        replacement_content: "import React, { useState } from \'react\';\nimport { WeatherAlert, WeatherObservation } from \'../types\';\nimport { CloudRain, Thermometer, Wind, Droplets, Sun, AlertTriangle, ShieldAlert, CheckCircle2, Info, RefreshCw } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface ClimateWidgetProps {\n  weather: WeatherObservation;\n  alerts: WeatherAlert[];\n  onRefresh?: () => void;\n}\n\nexport const ClimateWidget: React.FC<ClimateWidgetProps> = ({ weather, alerts, onRefresh }) => {\n  const [isRefreshing, setIsRefreshing] = useState(false);\n  const [lastRefreshedAt, setLastRefreshedAt] = useState<string>(new Date().toLocaleTimeString());\n  const isDataLive = weather.source.includes(\'Open-Meteo\') || weather.source.includes(\'Live API\');\n\n  const handleRefreshClick = async () => {\n    setIsRefreshing(true);\n    setLastRefreshedAt(new Date().toLocaleTimeString());\n    if (onRefresh) {\n      await onRefresh();\n    }\n    setTimeout(() => setIsRefreshing(false), 500);\n  };"
      }
      num_matches: 1
    }
  }
}
