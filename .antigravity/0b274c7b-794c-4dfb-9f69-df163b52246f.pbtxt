    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { WeatherAlert, WeatherObservation } from \'../types\';\nimport { CloudRain, Thermometer, Wind, Droplets, Sun, AlertTriangle, ShieldAlert, CheckCircle2 } from \'lucide-react\';\n\ninterface ClimateWidgetProps {\n  weather: WeatherObservation;\n  alerts: WeatherAlert[];\n}\n\nexport const ClimateWidget: React.FC<ClimateWidgetProps> = ({ weather, alerts }) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <CloudRain className=\"w-5 h-5 text-sky-600\" />\n            <h2 className=\"text-xl font-bold text-slate-900\">Hyperlocal Climate Intelligence</h2>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Real-time atmospheric telemetry and transparent rule-based agricultural advisories.\n          </p>\n        </div>\n\n        <div className=\"bg-sky-50 px-3 py-1.5 rounded-xl border border-sky-200 text-xs text-sky-900 font-medium\">\n          Source: <span className=\"font-bold\">{weather.source}</span>\n        </div>\n      </div>\n\n      {/* Atmospheric Metrics Grid */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4\">\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-1\">\n          <div className=\"flex items-center space-x-1.5 text-slate-500 text-xs\">\n            <Thermometer className=\"w-4 h-4 text-rose-500\" />\n            <span>Current Temp</span>\n          </div>\n          <span className=\"text-xl font-extrabold text-slate-900 block\">{weather.tempCurrentC}\302\260C</span>\n          <span className=\"text-[10px] text-slate-400 block\">High: {weather.tempMaxC}\302\260C</span>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-1\">\n          <div className=\"flex items-center space-x-1.5 text-slate-500 text-xs\">\n            <CloudRain className=\"w-4 h-4 text-sky-500\" />\n            <span>Precipitation</span>\n          </div>\n          <span className=\"text-xl font-extrabold text-slate-900 block\">{weather.precipitationMm} mm</span>\n          <span className=\"text-[10px] text-slate-400 block\">Prob: {weather.precipitationProbPercent}%</span>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-1\">\n          <div className=\"flex items-center space-x-1.5 text-slate-500 text-xs\">\n            <Droplets className=\"w-4 h-4 text-teal-500\" />\n            <span>Humidity</span>\n          </div>\n          <span className=\"text-xl font-extrabold text-slate-900 block\">{weather.humidityPercent}%</span>\n          <span className=\"text-[10px] text-slate-400 block\">Relative Air</span>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-1\">\n          <div className=\"flex items-center space-x-1.5 text-slate-500 text-xs\">\n            <Wind className=\"w-4 h-4 text-indigo-500\" />\n            <span>Wind Speed</span>\n          </div>\n          <span className=\"text-xl font-extrabold text-slate-900 block\">{weather.windSpeedKmH} km/h</span>\n          <span className=\"text-[10px] text-slate-400 block\">Surface Breeze</span>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-1\">\n          <div className=\"flex items-center space-x-1.5 text-slate-500 text-xs\">\n            <Sun className=\"w-4 h-4 text-amber-500\" />\n            <span>FAO ET0 Evapo.</span>\n          </div>\n          <span className=\"text-xl font-extrabold text-slate-900 block\">{weather.et0MmDay} mm/day</span>\n          <span className=\"text-[10px] text-slate-400 block\">Water Loss Index</span>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-1\">\n          <div className=\"flex items-center space-x-1.5 text-slate-500 text-xs\">\n            <ShieldAlert className=\"w-4 h-4 text-emerald-500\" />\n            <span>Climate Risk</span>\n          </div>\n          <span className=\"text-xl font-extrabold text-emerald-600 block\">LOW</span>\n          <span className=\"text-[10px] text-slate-400 block\">Score: 12 / 100</span>\n        </div>\n      </div>\n\n      {/* Actionable Rule-Based Alerts */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4\">\n        <h3 className=\"font-bold text-slate-900 text-sm border-b border-slate-100 pb-2\">Active Transparent Rule-Based Advisories</h3>\n\n        <div className=\"space-y-3\">\n          {alerts.map((a) => (\n            <div\n              key={a.id}\n              className={`p-4 rounded-xl border flex items-start space-x-3 ${\n                a.severity === \'WARNING\'\n                  ? \'bg-amber-50 border-amber-200 text-amber-900\'\n                  : \'bg-emerald-50 border-emerald-200 text-emerald-900\'\n              }`}\n            >\n              {a.severity === \'WARNING\' ? (\n                <AlertTriangle className=\"w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5\" />\n              ) : (\n                <CheckCircle2 className=\"w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5\" />\n              )}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center space-x-2\">\n                  <span className=\"font-bold text-sm\">{a.title}</span>\n                  <span className=\"text-[10px] bg-white px-2 py-0.5 rounded border text-slate-600 font-medium\">\n                    {a.type}\n                  </span>\n                </div>\n                <p className=\"text-xs\">{a.message}</p>\n                <div className=\"text-xs font-semibold pt-1 text-slate-900\">\n                  <span className=\"text-emerald-800\">Action: </span> {a.actionableRecommendation}\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
