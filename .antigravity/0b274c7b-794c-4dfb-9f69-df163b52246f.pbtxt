      original_chunk {
        target_content: "import React from \'react\';\nimport { CandidateCrop, ModelMetrics } from \'../types\';\nimport { Cpu, Calendar, BarChart3, CheckCircle2, ShieldAlert } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface CropPlanCardProps {\n  candidates: CandidateCrop[];\n  metrics: ModelMetrics;\n}\n\nexport const CropPlanCard: React.FC<CropPlanCardProps> = ({ candidates, metrics }) => {"
        replacement_content: "import React, { useState } from \'react\';\nimport { CandidateCrop, ModelMetrics } from \'../types\';\nimport { Cpu, Calendar, BarChart3, CheckCircle2, ShieldAlert, RefreshCw } from \'lucide-react\';\nimport { DataBadge } from \'./DataBadge\';\n\ninterface CropPlanCardProps {\n  candidates: CandidateCrop[];\n  metrics: ModelMetrics;\n  onRefresh?: () => void;\n}\n\nexport const CropPlanCard: React.FC<CropPlanCardProps> = ({ candidates, metrics, onRefresh }) => {\n  const [isRefreshing, setIsRefreshing] = useState(false);\n  const [lastRefreshedAt, setLastRefreshedAt] = useState<string>(new Date().toLocaleTimeString());\n\n  const handleRefreshClick = async () => {\n    setIsRefreshing(true);\n    setLastRefreshedAt(new Date().toLocaleTimeString());\n    if (onRefresh) {\n      await onRefresh();\n    }\n    setTimeout(() => setIsRefreshing(false), 500);\n  };"
      }
      num_matches: 1
    }
  }
