    replacement_chunks {
      replacement_content: "/**\n * AGMARKNET Mandi Price Dataset\n * Source: Government of India Data.gov.in / AGMARKNET\n * Kaggle Reference: Daily Wholesale Commodity Prices \342\200\223 India Mandis\n * License: Open Government Data License (OGDL) India\n */\n\nimport { MandiPriceRecord, PriceForecast } from \'../types\';\n\nexport const AGMARKNET_SNAPSHOT_RECORDS: MandiPriceRecord[] = [\n  // Haryana (Karnal / Kurukshetra)\n  {\n    id: \'MND_HR_01\',\n    state: \'Haryana\',\n    district: \'Karnal\',\n    market: \'Karnal Mandi\',\n    commodity: \'Wheat\',\n    variety: \'Dara\',\n    minPricePerKg: 22.5,\n    maxPricePerKg: 24.8,\n    modalPricePerKg: 23.5,\n    arrivalDate: \'2026-08-10\',\n    source: \'AGMARKNET Data.gov.in\',\n  },\n  {\n    id: \'MND_HR_02\',\n    state: \'Haryana\',\n    district: \'Karnal\',\n    market: \'Karnal Mandi\',\n    commodity: \'Paddy (Rice)\',\n    variety: \'PR-106 / Basmati\',\n    minPricePerKg: 31.0,\n    maxPricePerKg: 38.5,\n    modalPricePerKg: 35.0,\n    arrivalDate: \'2026-08-10\',\n    source: \'AGMARKNET Data.gov.in\',\n  },\n  {\n    id: \'MND_HR_03\',\n    state: \'Haryana\',\n    district: \'Karnal\',\n    market: \'Karnal Mandi\',\n    commodity: \'Mustard\',\n    variety: \'Black\',\n    minPricePerKg: 52.0,\n    maxPricePerKg: 58.0,\n    modalPricePerKg: 55.5,\n    arrivalDate: \'2026-08-10\',\n    source: \'AGMARKNET Data.gov.in\',\n  },\n\n  // Maharashtra (Pune / Nashik)\n  {\n    id: \'MND_MH_01\',\n    state: \'Maharashtra\',\n    district: \'Pune\',\n    market: \'Pune APMC\',\n    commodity: \'Onion\',\n    variety: \'Red\',\n    minPricePerKg: 18.0,\n    maxPricePerKg: 26.0,\n    modalPricePerKg: 22.0,\n    arrivalDate: \'2026-08-10\',\n    source: \'AGMARKNET Data.gov.in\',\n  },\n  {\n    id: \'MND_MH_02\',\n    state: \'Maharashtra\',\n    district: \'Pune\',\n    market: \'Pune APMC\',\n    commodity: \'Tomato\',\n    variety: \'Local Hybrid\',\n    minPricePerKg: 24.0,\n    maxPricePerKg: 34.