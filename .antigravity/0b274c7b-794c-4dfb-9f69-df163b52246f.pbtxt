    instruction: "Delegate weather forecasting and climate alert evaluation to OpenMeteoWeatherProvider"
    replacement_infos {
      original_chunk {
        target_content: "import { WeatherAlert, WeatherObservation } from \'../types\';\n\nexport class ClimateAgent {\n  /**\n   * Fetch live weather from Open-Meteo REST API or return verified snapshot fallback\n   */\n  static async fetchHyperlocalWeather(\n    latitude: number,\n    longitude: number\n  ): Promise<{ observation: WeatherObservation; alerts: WeatherAlert[] }> {\n    const timestamp = new Date().toISOString();\n\n    try {\n      const url = `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,et0_fao_evapotranspiration&timezone=auto`;\n\n      const res = await fetch(url);\n      if (!res.ok) {\n        throw new Error(`Open-Meteo API returned status ${res.status}`);\n      }\n\n      const data = await res.json();\n      const current = data.current || {};\n      const daily = data.daily || {};\n\n      const observation: WeatherObservation = {\n        timestamp,\n        latitude,\n        longitude,\n        tempCurrentC: current.temperature_2m ?? 28.5,\n        tempMaxC: daily.temperature_2m_max?.[0] ?? 34.0,\n        tempMinC: daily.temperature_2m_min?.[0] ?? 22.0,\n        precipitationMm: daily.precipitation_sum?.[0] ?? 0,\n        precipitationProbPercent: daily.precipitation_probability_max?.[0] ?? 15,\n        humidityPercent: current.relative_humidity_2m ?? 65,\n        windSpeedKmH: current.wind_speed_10m ?? 12,\n        et0MmDay: daily.et0_fao_evapotranspiration?.[0] ?? 4.2,\n        source: \'Open-Meteo REST API\',\n      };\n\n      const alerts = this.evaluateRules(observation);\n      return { observation, alerts };\n    } catch (err) {\n      console.warn(\'Open-Meteo API call failed, using verified geographical climate snapshot:\', err);\n\n      const fallbackObservation: WeatherObservation = {\n        timestamp,\n        latitude,\n        longitude,\n        tempCurrentC: 29.0,\n        tempMaxC: 35.2,\n        tempMinC: 23.0,\n        precipitationMm: 12.5,\n        precipitationProbPercent: 75,\n        humidityPercent: 70,\n        windSpeedKmH: 14,\n        et0MmDay: 4.0,\n        source: \'Cached Open-Meteo Snapshot\',\n      };\n\n      const alerts = this.evaluateRules(fallbackObservation);\n      return { observation: fallbackObservation, alerts };\n    }\n  }\n\n  /**\n   * Transparent rule-based climate advisory rules\n   */\n  private static evaluateRules(obs: WeatherObservation): WeatherAlert[] {\n    const alerts: WeatherAlert[] = [];\n    const ts = obs.timestamp;\n\n    // Rule 1: Rain Forecast / Irrigation Scheduling\n    if (obs.precipitationProbPercent >= 60 || obs.precipitationMm >= 10) {\n      alerts.push({\n        id: \'ALT_RAIN_01\',\n        type: \'IRRIGATION_SCHEDULE\',\n        severity: \'INFO\',\n        title: \'Skip / Reduce Irrigation\',\n        message: `High rainfall probability (${obs.precipitationProbPercent}%, ${obs.precipitationMm}mm expected) in forecast.`,\n        actionableRecommendation: \'Pause scheduled canal/borewell irrigation for 48 hours to prevent waterlogging and conserve pump fuel.\',\n        source: obs.source,\n        timestamp: ts,\n      });\n    } else {\n      alerts.push({\n        id: \'ALT_IRR_01\',\n        type: \'IRRIGATION_SCHEDULE\',\n        severity: \'INFO\',\n        title: \'Normal Irrigation Required\',\n        message: `Low rainfall forecast (${obs.precipitationProbPercent}%). Daily crop ET0 evapotranspiration is ${obs.et0MmDay} mm/day.`,\n        actionableRecommendation: `Apply ~${Math.round(obs.et0MmDay * 1.1 * 10)} cubic meters of water per acre via drip or furrow channel tonight.`,\n        source: obs.source,\n        timestamp: ts,\n      });\n    }\n\n    // Rule 2: Heat Safety Warning\n    if (obs.tempMaxC >= 38.0) {\n      alerts.push({\n        id: \'ALT_HEAT_01\',\n        type: \'HEAT_WARNING\',\n        severity: \'WARNING\',\n        title: \'Extreme Heat Warning for Field Labor\',\n        message: `Peak temperature expected to reach ${obs.tempMaxC}\302\260C.`,\n        actionableRecommendation: \'Schedule field labor before 10:30 AM or after 4:00 PM. Provide shade and hydration for farm workers and livestock.\',\n        source: obs.source,\n        timestamp: ts,\n      });\n    }\n\n    // Rule 3: Planting Window Advisory\n    if (obs.tempCurrentC >= 20 && obs.tempCurrentC <= 32 && obs.humidityPercent >= 50) {\n      alerts.push({\n        id: \'ALT_PLANT_01\',\n        type: \'PLANTING_WINDOW\',\n        severity: \'INFO\',\n        title: \'Favorable Sowing & Germination Window\',\n        message: `Optimal ambient temperature (${obs.tempCurrentC}\302\260C) and soil moisture retention conditions.`,\n        actionableRecommendation: \'Proceed with nursery bed preparation or direct seed sowing for Rabi pulses/mustard crops.\',\n        source: obs.source,\n        timestamp: ts,\n      });\n    }\n\n    return alerts;\n  }\n}"
        replacement_content: "import { WeatherAlert, WeatherObservation } from \'../types\';\nimport { OpenMeteoWeatherProvider } from \'./weather_provider\';\n\nexport class ClimateAgent {\n  /**\n   * Fetch live weather from Open-Meteo REST API using OpenMeteoWeatherProvider\n   */\n  static async fetchHyperlocalWeather(\n    latitude: number,\n    longitude: number\n  ): Promise<{ observation: WeatherObservation; alerts: WeatherAlert[] }> {\n    const provider = OpenMeteoWeatherProvider.getInstance();\n    return provider.getWeatherForecast(latitude, longitude);\n  }\n}"
      }
      num_matches: 1
    }
  }
}
