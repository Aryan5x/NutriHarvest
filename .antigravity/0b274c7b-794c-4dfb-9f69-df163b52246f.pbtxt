        }
        lines {
          text: "    for (let sample = 0; sample < 1; sample++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const area = Number((0.5 + pseudoRandom() * 4.5).toFixed(1));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const rain = Math.round(crop.rainOpt + (pseudoRandom() - 0.5) * 200);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const temp = Number((crop.tempOpt + (pseudoRandom() - 0.5) * 6).toFixed(1));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const fert = Math.round(100 + pseudoRandom() * 100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const pest = Number((0.5 + pseudoRandom() * 2.5).toFixed(1));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const ph = Number((crop.phOpt + (pseudoRandom() - 0.5) * 0.8).toFixed(1));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const n = Math.round(crop.nOpt + (pseudoRandom() - 0.5) * 30);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const p = Math.round(crop.pOpt + (pseudoRandom() - 0.5) * 15);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const k = Math.round(crop.kOpt + (pseudoRandom() - 0.5) * 25);"
