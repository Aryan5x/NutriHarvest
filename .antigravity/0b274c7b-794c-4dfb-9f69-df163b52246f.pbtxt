      target_content: "  useEffect(() => {\n    recalculateAgents();\n  }, [farm, farmer]);"
      replacement_content: "  useEffect(() => {\n    recalculateAgents();\n  }, [farm, farmer]);\n\n  // Supabase Auth session persistence across application restarts\n  useEffect(() => {\n    const initAuthSession = async () => {\n      const { session: currentSession } = await SupabaseService.getSession();\n      if (currentSession?.user) {\n        const userId = currentSession.user.id;\n        setSession({\n          user: {\n            id: userId,\n            email: currentSession.user.email || \'\',\n            farmerName: currentSession.user.user_metadata?.farmer_name || \'Ramesh Kumar\',\n          },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n\n        // Load profile & onboarding data from Supabase DB or local cache\n        const onboarding = await SupabaseService.getOnboardingProfile(userId);\n        if (onboarding.farmer) setFarmer(onboarding.farmer);\n        if (onboarding.farm) setFarm(onboarding.farm);\n      }\n    };\n\n    initAuthSession();\n\n    // Subscribe to auth state changes\n    const { subscription } = SupabaseService.onAuthStateChange(async (event, currentSession) => {\n      if (currentSession?.user) {\n        const userId = currentSession.user.id;\n        setSession({\n          user: {\n            id: userId,\n            email: currentSession.user.email || \'\',\n            farmerName: currentSession.user.user_metadata?.farmer_name || \'Ramesh Kumar\',\n          },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n\n        const onboarding = await SupabaseService.getOnboardingProfile(userId);\n        if (onboarding.farmer) setFarmer(onboarding.farmer);\n        if (onboarding.farm) setFarm(onboarding.farm);\n      } else if (event === \'SIGNED_OUT\') {\n        setSession({\n          user: null,\n          isLoggedIn: false,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n      }\n    });\n\n    return () => {\n      subscription?.unsubscribe();\n    };\n  }, []);"
    }
