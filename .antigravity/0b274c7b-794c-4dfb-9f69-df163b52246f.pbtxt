    instruction: "Update ExecutiveDashboard styling to match Natural Tones design theme"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { CandidateCrop, HarvestAllocation, ModelMetrics, NutritionCoverageScore, PriceForecast, WeatherObservation, WeatherAlert, HouseholdProfile, FarmProfile } from \'../types\';\nimport { Sprout, Heart, Store, Scale, Cpu, CloudRain, ShieldCheck, ArrowRight, DollarSign, Sparkles } from \'lucide-react\';\n\ninterface ExecutiveDashboardProps {\n  farmer: HouseholdProfile;\n  farm: FarmProfile;\n  coverage: NutritionCoverageScore;\n  candidates: CandidateCrop[];\n  weather: WeatherObservation;\n  alerts: WeatherAlert[];\n  forecast: PriceForecast;\n  allocation: HarvestAllocation;\n  metrics: ModelMetrics;\n  onNavigateTab: (tab: string) => void;\n}\n\nexport const ExecutiveDashboard: React.FC<ExecutiveDashboardProps> = ({\n  farmer,\n  farm,\n  coverage,\n  candidates,\n  weather,\n  alerts,\n  forecast,\n  allocation,\n  metrics,\n  onNavigateTab,\n}) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Welcome Hero Banner */}\n      <div className=\"bg-slate-900 text-white p-6 md:p-8 rounded-3xl shadow-xl border border-slate-800 relative overflow-hidden\">\n        <div className=\"relative z-10 max-w-3xl space-y-3\">\n          <div className=\"inline-flex items-center space-x-2 bg-emerald-950/80 text-emerald-400 text-xs px-3 py-1 rounded-full border border-emerald-800\">\n            <Sparkles className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span className=\"font-semibold\">AI Multi-Agent Optimization Matrix Active</span>\n          </div>\n          <h1 className=\"text-2xl md:text-3xl font-extrabold tracking-tight\">\n            Welcome, {farmer.farmerName} \342\200\224 {farm.district}, {farm.state}\n          </h1>\n          <p className=\"text-sm text-slate-300 leading-relaxed\">\n            Your {farm.landAreaAcres}-acre farm plan is dynamically synthesized across 5 specialized agents balancing ICMR 2020 RDA household nutrition with AGMARKNET market returns.\n          </p>\n\n          <div className=\"pt-2 flex flex-wrap gap-3 text-xs\">\n            <button\n              onClick={() => onNavigateTab(\'gemini\')}\n              className=\"bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl font-medium flex items-center space-x-2 shadow-md transition-all\"\n            >\n              <span>View Gemini Explanation & Listen Voice</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => onNavigateTab(\'profile\')}\n              className=\"bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-4 py-2 rounded-xl font-medium transition-all\"\n            >\n              <span>Edit Farm Parameters</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* 5 Agent Key Indicators Grid */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Card 1: Nutrition Coverage */}\n        <div\n          onClick={() => onNavigateTab(\'nutrition\')}\n          className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between text-slate-500\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">1. Nutrition Agent</span>\n            <Heart className=\"w-5 h-5 text-emerald-600 group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-extrabold text-slate-900\">{coverage.overallCoveragePercent}% RDA</div>\n          <p className=\"text-xs text-slate-500\">\n            {coverage.deficientNutrients.length === 0 ? \'All 7 nutrients met 100%\' : `Deficits in ${coverage.deficientNutrients.join(\', \')}`}\n          </p>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-emerald-700 flex items-center justify-between\">\n            <span>ICMR-NIN IFCT 2017</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n\n        {/* Card 2: XGBoost Yield */}\n        <div\n          onClick={() => onNavigateTab(\'crops\')}\n          className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between text-slate-500\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">2. Crop ML Agent</span>\n            <Cpu className=\"w-5 h-5 text-purple-600 group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-extrabold text-slate-900\">{allocation.totalHarvestKg} kg</div>\n          <p className=\"text-xs text-slate-500\">\n            {candidates.length} crops selected for {farm.landAreaAcres} acres\n          </p>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-purple-700 flex items-center justify-between\">\n            <span>XGBoost (R\302\262 = {metrics.r2Score})</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n\n        {/* Card 3: Mandi Market Forecast */}\n        <div\n          onClick={() => onNavigateTab(\'market\')}\n          className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between text-slate-500\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">3. Market Agent</span>\n            <Store className=\"w-5 h-5 text-amber-600 group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-extrabold text-slate-900\">\342\202\271{forecast.forecastedModalPrice} / kg</div>\n          <p className=\"text-xs text-slate-500\">30-day Prophet forecast ({forecast.trend})</p>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-amber-700 flex items-center justify-between\">\n            <span>AGMARKNET Mandi Feed</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n\n        {/* Card 4: Net Income & OR-Tools Optimization */}\n        <div\n          onClick={() => onNavigateTab(\'allocation\')}\n          className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between text-slate-500\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">4. Finance & OR-Tools</span>\n            <Scale className=\"w-5 h-5 text-teal-600 group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-extrabold text-slate-900\">\342\202\271{allocation.netExpectedIncomeInr.toLocaleString(\'en-IN\')}</div>\n          <p className=\"text-xs text-slate-500\">Optimal closed-loop harvest allocation</p>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-teal-700 flex items-center justify-between\">\n            <span>Simplex LP Solver</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n      </div>\n\n      {/* Climate & Weather Live Alert Bar */}\n      <div\n        onClick={() => onNavigateTab(\'climate\')}\n        className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 cursor-pointer hover:border-sky-300 transition-all\"\n      >\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-3 rounded-xl bg-sky-50 border border-sky-200 text-sky-600\">\n            <CloudRain className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <span className=\"text-xs font-bold uppercase tracking-wider text-sky-800\">5. Hyperlocal Climate Agent</span>\n            <p className=\"text-sm font-bold text-slate-900 mt-0.5\">\n              Current: {weather.tempCurrentC}\302\260C | Rain Prob: {weather.precipitationProbPercent}% | FAO ET0: {weather.et0MmDay} mm/day\n            </p>\n          </div>\n        </div>\n        <div className=\"text-xs font-semibold text-sky-700 flex items-center space-x-1\">\n          <span>{alerts.length} Active Weather Advisories</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { CandidateCrop, HarvestAllocation, ModelMetrics, NutritionCoverageScore, PriceForecast, WeatherObservation, WeatherAlert, HouseholdProfile, FarmProfile } from \'../types\';\nimport { Sprout, Heart, Store, Scale, Cpu, CloudRain, ShieldCheck, ArrowRight, DollarSign, Sparkles } from \'lucide-react\';\n\ninterface ExecutiveDashboardProps {\n  farmer: HouseholdProfile;\n  farm: FarmProfile;\n  coverage: NutritionCoverageScore;\n  candidates: CandidateCrop[];\n  weather: WeatherObservation;\n  alerts: WeatherAlert[];\n  forecast: PriceForecast;\n  allocation: HarvestAllocation;\n  metrics: ModelMetrics;\n  onNavigateTab: (tab: string) => void;\n}\n\nexport const ExecutiveDashboard: React.FC<ExecutiveDashboardProps> = ({\n  farmer,\n  farm,\n  coverage,\n  candidates,\n  weather,\n  alerts,\n  forecast,\n  allocation,\n  metrics,\n  onNavigateTab,\n}) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Welcome Hero Banner - Natural Tones Theme */}\n      <div className=\"bg-[#EBE7DF] text-[#2D302D] p-6 md:p-8 rounded-2xl shadow-xs border border-[#D9D4C7] relative overflow-hidden\">\n        <div className=\"relative z-10 max-w-3xl space-y-3\">\n          <div className=\"inline-flex items-center space-x-2 bg-[#F2F8F0] text-[#4A6741] text-xs px-3 py-1 rounded-md border border-[#4A6741]/20 font-semibold\">\n            <Sparkles className=\"w-3.5 h-3.5 text-[#4A6741]\" />\n            <span>Seasonal Decision Support Matrix</span>\n          </div>\n          <h1 className=\"text-3xl md:text-4xl font-serif italic text-[#4A6741] tracking-tight\">\n            Welcome, {farmer.farmerName} \342\200\224 {farm.district}, {farm.state}\n          </h1>\n          <p className=\"text-sm text-[#6B6E6B] leading-relaxed\">\n            Optimizing for Family Nutrition & Market Surplus across your {farm.landAreaAcres}-acre farm. Synthesized dynamically via 5 specialized AI agents combining ICMR 2020 RDA guidelines and AGMARKNET market feeds.\n          </p>\n\n          <div className=\"pt-2 flex flex-wrap gap-3 text-xs\">\n            <button\n              onClick={() => onNavigateTab(\'gemini\')}\n              className=\"bg-[#4A6741] hover:bg-[#3A5033] text-white px-4 py-2 rounded-xl font-medium flex items-center space-x-2 shadow-xs transition-all cursor-pointer\"\n            >\n              <span>View Gemini Explanation & Listen Voice</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => onNavigateTab(\'profile\')}\n              className=\"bg-[#F2EDE4] hover:bg-[#D9D4C7] text-[#2D302D] border border-[#D9D4C7] px-4 py-2 rounded-xl font-medium transition-all cursor-pointer\"\n            >\n              <span>Edit Farm Parameters</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* 5 Agent Key Indicators Grid */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Card 1: Nutrition Coverage */}\n        <div\n          onClick={() => onNavigateTab(\'nutrition\')}\n          className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs hover:border-[#D9D4C7] hover:shadow-sm transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#6B6E6B]\">1. Nutrition Coverage</span>\n            <Heart className=\"w-5 h-5 text-[#4A6741] group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-mono font-bold text-[#2D302D]\">{coverage.overallCoveragePercent}% RDA</div>\n          <p className=\"text-xs text-[#6B6E6B]\">\n            {coverage.deficientNutrients.length === 0 ? \'All 7 nutrients met 100%\' : `Deficits in ${coverage.deficientNutrients.join(\', \')}`}\n          </p>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-semibold text-[#4A6741] flex items-center justify-between\">\n            <span>ICMR-NIN IFCT 2017</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n\n        {/* Card 2: XGBoost Yield */}\n        <div\n          onClick={() => onNavigateTab(\'crops\')}\n          className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs hover:border-[#D9D4C7] hover:shadow-sm transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#6B6E6B]\">2. Yield Prediction</span>\n            <Cpu className=\"w-5 h-5 text-[#8B5E34] group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-mono font-bold text-[#2D302D]\">{allocation.totalHarvestKg} kg</div>\n          <p className=\"text-xs text-[#6B6E6B]\">\n            {candidates.length} crops for {farm.landAreaAcres} acres\n          </p>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-semibold text-[#8B5E34] flex items-center justify-between\">\n            <span>XGBoost Model (R\302\262 = {metrics.r2Score})</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n\n        {/* Card 3: Mandi Market Forecast */}\n        <div\n          onClick={() => onNavigateTab(\'market\')}\n          className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs hover:border-[#D9D4C7] hover:shadow-sm transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#6B6E6B]\">3. Market Intelligence</span>\n            <Store className=\"w-5 h-5 text-[#D4A373] group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-mono font-bold text-[#2D302D]\">\342\202\271{forecast.forecastedModalPrice} / kg</div>\n          <p className=\"text-xs text-[#6B6E6B]\">30-day Prophet forecast ({forecast.trend})</p>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-semibold text-[#8B5E34] flex items-center justify-between\">\n            <span>AGMARKNET Mandi Feed</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n\n        {/* Card 4: Net Income & OR-Tools Optimization */}\n        <div\n          onClick={() => onNavigateTab(\'allocation\')}\n          className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs hover:border-[#D9D4C7] hover:shadow-sm transition-all cursor-pointer space-y-2 group\"\n        >\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#6B6E6B]\">4. Finance & Allocation</span>\n            <Scale className=\"w-5 h-5 text-[#4A6741] group-hover:scale-110 transition-all\" />\n          </div>\n          <div className=\"text-2xl font-mono font-bold text-[#2D302D]\">\342\202\271{allocation.netExpectedIncomeInr.toLocaleString(\'en-IN\')}</div>\n          <p className=\"text-xs text-[#6B6E6B]\">Optimal closed-loop harvest allocation</p>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-semibold text-[#4A6741] flex items-center justify-between\">\n            <span>OR-Tools Simplex Solver</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </div>\n        </div>\n      </div>\n\n      {/* Climate & Weather Live Alert Bar */}\n      <div\n        onClick={() => onNavigateTab(\'climate\')}\n        className=\"bg-[#FDF9F3] p-5 rounded-2xl border border-[#D9D4C7] border-l-4 border-l-[#D4A373] shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 cursor-pointer hover:bg-[#F2EDE4] transition-all\"\n      >\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-3 rounded-xl bg-[#EBE7DF] text-[#8B5E34]\">\n            <CloudRain className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#8B5E34]\">5. Hyperlocal Climate Advisory</span>\n            <p className=\"text-sm font-bold text-[#2D302D] mt-0.5\">\n              Current: {weather.tempCurrentC}\302\260C | Rain Prob: {weather.precipitationProbPercent}% | FAO ET0: {weather.et0MmDay} mm/day\n            </p>\n          </div>\n        </div>\n        <div className=\"text-xs font-semibold text-[#8B5E34] flex items-center space-x-1\">\n          <span>{alerts.length} Active Weather Advisories</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </div>\n      </div>\n    </div>\n  );\n};"
      }
