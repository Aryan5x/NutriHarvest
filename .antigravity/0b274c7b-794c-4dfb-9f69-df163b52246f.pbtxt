  file_change {
    absolute_path_uri: "file:///src/components/NutritionDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { NutritionCoverageScore, NutrientTarget } from \'../types\';\nimport { HeartPulse, AlertCircle, CheckCircle2, ShieldCheck, PieChart } from \'lucide-react\';\n\ninterface NutritionDashboardProps {\n  coverage: NutritionCoverageScore;\n  target: NutrientTarget;\n  achieved: NutrientTarget;\n}\n\nexport const NutritionDashboard: React.FC<NutritionDashboardProps> = ({\n  coverage,\n  target,\n  achieved,\n}) => {\n  const nutrients = [\n    { name: \'Protein\', unit: \'g\', achieved: Math.round(achieved.proteinGrams), target: Math.round(target.proteinGrams), score: coverage.proteinCoveragePercent, color: \'bg-emerald-500\' },\n    { name: \'Iron\', unit: \'mg\', achieved: Math.round(achieved.ironMg), target: Math.round(target.ironMg), score: coverage.ironCoveragePercent, color: \'bg-rose-500\' },\n    { name: \'Calcium\', unit: \'mg\', achieved: Math.round(achieved.calciumMg), target: Math.round(target.calciumMg), score: coverage.calciumCoveragePercent, color: \'bg-amber-500\' },\n    { name: \'Vitamin A\', unit: \'mcg\', achieved: Math.round(achieved.vitaminAMcg), target: Math.round(target.vitaminAMcg), score: coverage.vitaminACoveragePercent, color: \'bg-orange-500\' },\n    { name: \'Vitamin C\', unit: \'mg\', achieved: Math.round(achieved.vitaminCMg), target: Math.round(target.vitaminCMg), score: coverage.vitaminCCoveragePercent, color: \'bg-yellow-500\' },\n    { name: \'Dietary Fiber\', unit: \'g\', achieved: Math.round(achieved.fiberGrams), target: Math.round(target.fiberGrams), score: coverage.fiberCoveragePercent, color: \'bg-teal-500\' },\n    { name: \'Calories\', unit: \'kcal\', achieved: Math.round(achieved.caloriesKcal), target: Math.round(target.caloriesKcal), score: coverage.caloriesCoveragePercent, color: \'bg-sky-500\' },\n  ];\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Overview Ring & Summary Card */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6\">\n        <div className=\"flex items-center space-x-5\">\n          <div className=\"relative w-28 h-28 flex items-center justify-center rounded-full bg-emerald-50 border-4 border-emerald-500 shadow-inner\">\n            <div className=\"text-center\">\n              <span className=\"text-2xl font-extrabold text-emerald-900 block\">{coverage.overallCoveragePercent}%</span>\n              <span className=\"text-[10px] font-semibold uppercase tracking-wider text-emerald-700\">RDA Coverage</span>\n            </div>\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <HeartPulse className=\"w-5 h-5 text-emerald-600\" />\n              <h2 className=\"text-lg font-bold text-slate-900\">Household Monthly Nutrition Coverage Score</h2>\n            </div>\n            <p className=\"text-xs text-slate-500 mt-1 max-w-md\">\n              Calculated using ICMR 2020 Recommended Dietary Allowances (RDA) and ICMR-NIN IFCT 2017 raw food composition tables.\n            </p>\n            <div className=\"mt-2 flex items-center space-x-2 text-xs\">\n              <span className=\"bg-emerald-100 text-emerald-800 font-semibold px-2.5 py-0.5 rounded-full\">\n                ICMR 2020 RDA Standard\n              </span>\n              <span className=\"text-slate-400\">\342\200\242</span>\n              <span className=\"text-slate-600 font-medium\">Deterministic Calculation</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Micronutrient Deficiencies Badge */}\n        <div className=\"w-full md:w-auto bg-slate-50 p-4 rounded-xl border border-slate-200 min-w-[280px]\">\n          <span className=\"text-xs font-semibold text-slate-700 block mb-2\">Identified Nutrient Status</span>\n          {coverage.deficientNutrients.length === 0 ? (\n            <div className=\"flex items-center space-x-2 text-emerald-700 text-xs font-medium bg-emerald-50 p-2.5 rounded-lg border border-emerald-200\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-600 flex-shrink-0\" />\n              <span>All 7 key macronutrients & micronutrients meet 100% RDA!</span>\n            </div>\n          ) : (\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center space-x-2 text-amber-800 text-xs font-medium bg-amber-50 p-2 rounded-lg border border-amber-200\">\n                <AlertCircle className=\"w-4 h-4 text-amber-600 flex-shrink-0\" />\n                <span>Gaps found in: {coverage.deficientNutrients.join(\', \')}</span>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Breakdown Progress Bars */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4\">\n        <h3 className=\"font-bold text-slate-900 text-sm border-b border-slate-100 pb-2\">Nutrient-by-Nutrient Breakdown vs Monthly Target</h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          {nutrients.map((n) => (\n            <div key={n.name} className=\"p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2\">\n              <div className=\"flex justify-between items-center text-xs font-semibold\">\n                <span className=\"text-slate-800\">{n.name}</span>\n                <span className=\"text-slate-600\">\n                  {n.achieved} / {n.target} {n.unit} ({n.score}%)\n                </span>\n              </div>\n              <div className=\"w-full bg-slate-200 h-2.5 rounded-full overflow-hidden\">\n                <div\n                  className={`h-full ${n.color} transition-all duration-500 rounded-full`}\n                  style={{ width: `${Math.min(100, n.score)}%` }}\n                />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Gap Fill Recommendations */}\n      {coverage.recommendedFoodsToFillGaps.length > 0 && (\n        <div className=\"bg-emerald-950 text-emerald-100 p-6 rounded-2xl border border-emerald-900 shadow-md space-y-3\">\n          <div className=\"flex items-center space-x-2 text-emerald-400 font-bold text-sm\">\n            <ShieldCheck className=\"w-5 h-5 text-emerald-400\" />\n            <span>Targeted Crop-Diet Match Recommendations to Eliminate Gaps</span>\n          </div>\n          <ul className=\"space-y-2 text-xs text-emerald-200/90 pl-2\">\n            {coverage.recommendedFoodsToFillGaps.map((rec, idx) => (\n              <li key={idx} className=\"flex items-start space-x-2\">\n                <span className=\"text-emerald-400 font-bold\">\342\200\242</span>\n                <span>{rec}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
