        }
        lines {
          text: "      [\'children0_5\', \'children0_5\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      [\'children6_12\', \'children6_12\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      [\'teens13_18\', \'teens13_18\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      [\'adults19_59\', \'adults19_59\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      [\'seniors60Plus\', \'seniors60Plus\'],"
