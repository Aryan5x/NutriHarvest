    instruction: "Update HarvestAllocationOptimizer styling to match Natural Tones design theme"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { HarvestAllocation, CandidateCrop } from \'../types\';\nimport { Scale, Heart, ShoppingBag, Archive, Shield, Sprout, DollarSign, AlertCircle, CheckCircle2 } from \'lucide-react\';\n\ninterface HarvestAllocationOptimizerProps {\n  crop: CandidateCrop;\n  allocation: HarvestAllocation;\n  onSolve: () => void;\n}\n\nexport const HarvestAllocationOptimizer: React.FC<HarvestAllocationOptimizerProps> = ({\n  crop,\n  allocation,\n  onSolve,\n}) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <Scale className=\"w-5 h-5 text-emerald-600\" />\n            <h2 className=\"text-xl font-bold text-slate-900\">Closed-Loop OR-Tools Harvest Allocation Solver</h2>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Simplex Linear Programming allocating harvest between family nutrition, market sale, storage, emergency reserve, and seeds.\n          </p>\n        </div>\n\n        <button\n          onClick={onSolve}\n          className=\"bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl font-medium text-sm flex items-center space-x-2 shadow-md shadow-emerald-700/20 transition-all\"\n        >\n          <Scale className=\"w-4 h-4 text-emerald-100\" />\n          <span>Re-Run OR-Tools Optimization</span>\n        </button>\n      </div>\n\n      {/* Feasibility Alert */}\n      {!allocation.isFeasible ? (\n        <div className=\"bg-rose-50 border border-rose-200 p-4 rounded-2xl flex items-start space-x-3 text-rose-900 text-xs\">\n          <AlertCircle className=\"w-5 h-5 text-rose-600 flex-shrink-0 mt-0.5\" />\n          <div>\n            <span className=\"font-bold block text-sm\">Constraint Conflict / Infeasible State</span>\n            <p className=\"mt-1\">{allocation.constraintWarnings[0]}</p>\n          </div>\n        </div>\n      ) : (\n        <div className=\"bg-emerald-50 border border-emerald-200 p-4 rounded-2xl flex items-center space-x-3 text-emerald-900 text-xs\">\n          <CheckCircle2 className=\"w-5 h-5 text-emerald-600 flex-shrink-0\" />\n          <div>\n            <span className=\"font-bold block text-sm\">Feasible Optimal LP Solution Found</span>\n            <p>100% of harvest ({allocation.totalHarvestKg} kg) allocated without violating family nutrition or storage bounds.</p>\n          </div>\n        </div>\n      )}\n\n      {/* 5-Way Allocation Vector Grid */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n        {/* 1. Family Consumption */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n          <div className=\"flex items-center space-x-2 text-rose-600\">\n            <Heart className=\"w-5 h-5 fill-rose-100\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">Family Food</span>\n          </div>\n          <span className=\"text-2xl font-extrabold text-slate-900 block\">{allocation.familyConsumptionKg} kg</span>\n          <span className=\"text-[11px] text-slate-500 block\">3-Month Household Nutrition</span>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-emerald-700\">\n            {allocation.nutritionSatisfactionScorePercent}% RDA Covered\n          </div>\n        </div>\n\n        {/* 2. Immediate Market Sale */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n          <div className=\"flex items-center space-x-2 text-emerald-600\">\n            <ShoppingBag className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">Mandi Sale</span>\n          </div>\n          <span className=\"text-2xl font-extrabold text-slate-900 block\">{allocation.marketSaleKg} kg</span>\n          <span className=\"text-[11px] text-slate-500 block\">Immediate Cash Revenue</span>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-slate-700\">\n            Transport: -\342\202\271{allocation.transportCostInr}\n          </div>\n        </div>\n\n        {/* 3. Storage for Future Sale */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n          <div className=\"flex items-center space-x-2 text-amber-600\">\n            <Archive className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">Storage</span>\n          </div>\n          <span className=\"text-2xl font-extrabold text-slate-900 block\">{allocation.storageKg} kg</span>\n          <span className=\"text-[11px] text-slate-500 block\">Hold for Peak Price</span>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-slate-700\">\n            Storage Cost: -\342\202\271{allocation.storageCostInr}\n          </div>\n        </div>\n\n        {/* 4. Emergency Buffer */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n          <div className=\"flex items-center space-x-2 text-sky-600\">\n            <Shield className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">Emergency Buffer</span>\n          </div>\n          <span className=\"text-2xl font-extrabold text-slate-900 block\">{allocation.emergencyBufferKg} kg</span>\n          <span className=\"text-[11px] text-slate-500 block\">Climate Risk Protection</span>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-sky-700\">\n            7% Resilience Safety\n          </div>\n        </div>\n\n        {/* 5. Seed Reserve */}\n        <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2\">\n          <div className=\"flex items-center space-x-2 text-teal-600\">\n            <Sprout className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-slate-700\">Seed Reserve</span>\n          </div>\n          <span className=\"text-2xl font-extrabold text-slate-900 block\">{allocation.seedReserveKg} kg</span>\n          <span className=\"text-[11px] text-slate-500 block\">Next Crop Planting</span>\n          <div className=\"pt-2 border-t border-slate-100 text-[11px] font-semibold text-teal-700\">\n            5% Self-Sufficiency\n          </div>\n        </div>\n      </div>\n\n      {/* Net Expected Income Optimization Result */}\n      <div className=\"bg-slate-900 text-white p-6 rounded-2xl shadow-lg border border-slate-800 space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n          <div className=\"flex items-center space-x-2\">\n            <DollarSign className=\"w-6 h-6 text-emerald-400\" />\n            <h3 className=\"text-lg font-bold text-white\">Net Expected Farmer Income (Post-Costs)</h3>\n          </div>\n          <span className=\"text-3xl font-extrabold text-emerald-400\">\342\202\271{allocation.netExpectedIncomeInr.toLocaleString(\'en-IN\')}</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-slate-300\">\n          <div>\n            <span className=\"text-slate-400 block\">Immediate Mandi Revenue</span>\n            <span className=\"font-bold text-white\">\342\202\271{(allocation.marketSaleKg * 23.5).toLocaleString(\'en-IN\')}</span>\n          </div>\n          <div>\n            <span className=\"text-slate-400 block\">Future Forecasted Storage Revenue</span>\n            <span className=\"font-bold text-white\">\342\202\271{Math.round(allocation.storageKg * 25.0 * 0.95).toLocaleString(\'en-IN\')}</span>\n          </div>\n          <div>\n            <span className=\"text-slate-400 block\">Total Operational Costs (Input + Transport + Storage)</span>\n            <span className=\"font-bold text-rose-400\">-\342\202\271{Math.round(crop.costPerAcreInr * crop.recommendedAcreage + allocation.transportCostInr + allocation.storageCostInr).toLocaleString(\'en-IN\')}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { HarvestAllocation, CandidateCrop } from \'../types\';\nimport { Scale, Heart, ShoppingBag, Archive, Shield, Sprout, DollarSign, AlertCircle, CheckCircle2 } from \'lucide-react\';\n\ninterface HarvestAllocationOptimizerProps {\n  crop: CandidateCrop;\n  allocation: HarvestAllocation;\n  onSolve: () => void;\n}\n\nexport const HarvestAllocationOptimizer: React.FC<HarvestAllocationOptimizerProps> = ({\n  crop,\n  allocation,\n  onSolve,\n}) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <Scale className=\"w-5 h-5 text-[#4A6741]\" />\n            <h2 className=\"text-2xl font-serif italic text-[#4A6741]\">Closed-Loop OR-Tools Harvest Allocation Solver</h2>\n          </div>\n          <p className=\"text-xs text-[#6B6E6B] mt-1\">\n            Simplex Linear Programming allocating harvest between family nutrition, market sale, storage, emergency reserve, and seeds.\n          </p>\n        </div>\n\n        <button\n          onClick={onSolve}\n          className=\"bg-[#4A6741] hover:bg-[#3A5033] text-white px-5 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider flex items-center space-x-2 shadow-xs transition-all\"\n        >\n          <Scale className=\"w-4 h-4 text-white\" />\n          <span>Re-Run OR-Tools Optimization</span>\n        </button>\n      </div>\n\n      {/* Feasibility Alert */}\n      {!allocation.isFeasible ? (\n        <div className=\"bg-[#FDF9F3] border border-[#D4A373]/40 p-4 rounded-2xl flex items-start space-x-3 text-[#8B5E34] text-xs\">\n          <AlertCircle className=\"w-5 h-5 text-[#D4A373] flex-shrink-0 mt-0.5\" />\n          <div>\n            <span className=\"font-bold block text-sm\">Constraint Conflict / Infeasible State</span>\n            <p className=\"mt-1\">{allocation.constraintWarnings[0]}</p>\n          </div>\n        </div>\n      ) : (\n        <div className=\"bg-[#F2F8F0] border border-[#4A6741]/20 p-4 rounded-2xl flex items-center space-x-3 text-[#4A6741] text-xs\">\n          <CheckCircle2 className=\"w-5 h-5 text-[#4A6741] flex-shrink-0\" />\n          <div>\n            <span className=\"font-bold block text-sm\">Feasible Optimal LP Solution Found</span>\n            <p className=\"text-[#2D302D]\">100% of harvest ({allocation.totalHarvestKg} kg) allocated without violating family nutrition or storage bounds.</p>\n          </div>\n        </div>\n      )}\n\n      {/* 5-Way Allocation Vector Grid */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n        {/* 1. Family Consumption */}\n        <div className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-2\">\n          <div className=\"flex items-center space-x-2 text-[#4A6741]\">\n            <Heart className=\"w-5 h-5 fill-[#F2F8F0]\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#2D302D]\">Family Food</span>\n          </div>\n          <span className=\"text-2xl font-mono font-bold text-[#2D302D] block\">{allocation.familyConsumptionKg} kg</span>\n          <span className=\"text-[11px] text-[#6B6E6B] block\">3-Month Household Nutrition</span>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-bold text-[#4A6741]\">\n            {allocation.nutritionSatisfactionScorePercent}% RDA Covered\n          </div>\n        </div>\n\n        {/* 2. Immediate Market Sale */}\n        <div className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-2\">\n          <div className=\"flex items-center space-x-2 text-[#4A6741]\">\n            <ShoppingBag className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#2D302D]\">Mandi Sale</span>\n          </div>\n          <span className=\"text-2xl font-mono font-bold text-[#2D302D] block\">{allocation.marketSaleKg} kg</span>\n          <span className=\"text-[11px] text-[#6B6E6B] block\">Immediate Cash Revenue</span>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-mono font-medium text-[#6B6E6B]\">\n            Transport: -\342\202\271{allocation.transportCostInr}\n          </div>\n        </div>\n\n        {/* 3. Storage for Future Sale */}\n        <div className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-2\">\n          <div className=\"flex items-center space-x-2 text-[#D4A373]\">\n            <Archive className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#2D302D]\">Storage</span>\n          </div>\n          <span className=\"text-2xl font-mono font-bold text-[#2D302D] block\">{allocation.storageKg} kg</span>\n          <span className=\"text-[11px] text-[#6B6E6B] block\">Hold for Peak Price</span>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-mono font-medium text-[#6B6E6B]\">\n            Storage Cost: -\342\202\271{allocation.storageCostInr}\n          </div>\n        </div>\n\n        {/* 4. Emergency Buffer */}\n        <div className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-2\">\n          <div className=\"flex items-center space-x-2 text-[#4A6741]\">\n            <Shield className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#2D302D]\">Emergency Buffer</span>\n          </div>\n          <span className=\"text-2xl font-mono font-bold text-[#2D302D] block\">{allocation.emergencyBufferKg} kg</span>\n          <span className=\"text-[11px] text-[#6B6E6B] block\">Climate Risk Protection</span>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-bold text-[#4A6741]\">\n            7% Resilience Safety\n          </div>\n        </div>\n\n        {/* 5. Seed Reserve */}\n        <div className=\"bg-white p-5 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-2\">\n          <div className=\"flex items-center space-x-2 text-[#4A6741]\">\n            <Sprout className=\"w-5 h-5\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#2D302D]\">Seed Reserve</span>\n          </div>\n          <span className=\"text-2xl font-mono font-bold text-[#2D302D] block\">{allocation.seedReserveKg} kg</span>\n          <span className=\"text-[11px] text-[#6B6E6B] block\">Next Crop Planting</span>\n          <div className=\"pt-2 border-t border-[#EBE7DF] text-[11px] font-bold text-[#4A6741]\">\n            5% Self-Sufficiency\n          </div>\n        </div>\n      </div>\n\n      {/* Net Expected Income Optimization Result */}\n      <div className=\"bg-[#4A6741] text-white p-6 rounded-2xl shadow-xs border border-[#3A5033] space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-white/20 pb-3\">\n          <div className=\"flex items-center space-x-2\">\n            <DollarSign className=\"w-6 h-6 text-[#D4A373]\" />\n            <h3 className=\"text-lg font-bold text-white\">Net Expected Farmer Income (Post-Costs)</h3>\n          </div>\n          <span className=\"text-3xl font-mono font-bold text-[#D4A373]\">\342\202\271{allocation.netExpectedIncomeInr.toLocaleString(\'en-IN\')}</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-white/90\">\n          <div>\n            <span className=\"text-white/70 uppercase tracking-wider text-[10px] block\">Immediate Mandi Revenue</span>\n            <span className=\"font-mono font-bold text-white text-sm\">\342\202\271{(allocation.marketSaleKg * 23.5).toLocaleString(\'en-IN\')}</span>\n          </div>\n          <div>\n            <span className=\"text-white/70 uppercase tracking-wider text-[10px] block\">Future Forecasted Storage Revenue</span>\n            <span className=\"font-mono font-bold text-white text-sm\">\342\202\271{Math.round(allocation.storageKg * 25.0 * 0.95).toLocaleString(\'en-IN\')}</span>\n          </div>\n          <div>\n            <span className=\"text-white/70 uppercase tracking-wider text-[10px] block\">Total Operational Costs (Input + Transport + Storage)</span>\n            <span className=\"font-mono font-bold text-[#D4A373] text-sm\">-\342\202\271{Math.round(crop.costPerAcreInr * crop.recommendedAcreage + allocation.transportCostInr + allocation.storageCostInr).toLocaleString(\'en-IN\')}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
