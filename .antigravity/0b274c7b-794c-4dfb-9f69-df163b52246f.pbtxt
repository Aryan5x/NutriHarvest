    instruction: "Update MarketTrendsCard styling to match Natural Tones design theme"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { MandiPriceRecord, PriceForecast } from \'../types\';\nimport { TrendingUp, Store, DollarSign, Calendar, AlertCircle } from \'lucide-react\';\n\ninterface MarketTrendsCardProps {\n  records: MandiPriceRecord[];\n  forecast: PriceForecast;\n}\n\nexport const MarketTrendsCard: React.FC<MarketTrendsCardProps> = ({ records, forecast }) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <Store className=\"w-5 h-5 text-amber-600\" />\n            <h2 className=\"text-xl font-bold text-slate-900\">AGMARKNET Mandi Feed & Prophet Price Forecast</h2>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Official wholesale mandi arrival prices and 30-day time series price trend forecaster.\n          </p>\n        </div>\n\n        <div className=\"bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-200 text-xs text-amber-900 font-medium\">\n          Source: <span className=\"font-bold\">Government of India Data.gov.in / AGMARKNET</span>\n        </div>\n      </div>\n\n      {/* Primary Forecast Display Card */}\n      <div className=\"bg-slate-900 text-white p-6 rounded-2xl shadow-md border border-slate-800 space-y-4\">\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-800 pb-3\">\n          <div>\n            <span className=\"text-xs text-amber-400 font-bold uppercase tracking-wider block\">Prophet Forecast Model</span>\n            <h3 className=\"text-lg font-bold text-white\">{forecast.commodity} \342\200\224 Best Selling Market Recommendation</h3>\n          </div>\n          <span className=\"bg-emerald-950 text-emerald-400 border border-emerald-800 text-xs px-3 py-1 rounded-full font-bold\">\n            Trend: {forecast.trend}\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs\">\n          <div className=\"bg-slate-800/80 p-4 rounded-xl border border-slate-700/60\">\n            <span className=\"text-slate-400 block mb-1\">Latest Observed Modal Price</span>\n            <span className=\"text-2xl font-extrabold text-amber-400\">\342\202\271{forecast.observedModalPrice} / kg</span>\n            <span className=\"text-[10px] text-slate-400 block mt-1\">Mandi Arrival Feed</span>\n          </div>\n\n          <div className=\"bg-slate-800/80 p-4 rounded-xl border border-slate-700/60\">\n            <span className=\"text-slate-400 block mb-1\">30-Day Forecasted Modal Price</span>\n            <span className=\"text-2xl font-extrabold text-emerald-400\">\342\202\271{forecast.forecastedModalPrice} / kg</span>\n            <span className=\"text-[10px] text-emerald-300 block mt-1\">\n              Conf. Interval: \342\202\271{forecast.confidenceInterval[0]} - \342\202\271{forecast.confidenceInterval[1]}\n            </span>\n          </div>\n\n          <div className=\"bg-slate-800/80 p-4 rounded-xl border border-slate-700/60\">\n            <span className=\"text-slate-400 block mb-1\">Recommended Selling Strategy</span>\n            <span className=\"text-xs font-bold text-slate-200 block mt-1\">{forecast.recommendedSellingWindow}</span>\n            <span className=\"text-[10px] text-slate-400 block mt-1\">Target Date: {forecast.forecastDate}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Observed Mandi Prices Table */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4\">\n        <h3 className=\"font-bold text-slate-900 text-sm border-b border-slate-100 pb-2\">Verified Regional Mandi Arrival Records</h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse text-xs\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-slate-700 font-semibold\">\n                <th className=\"py-3 px-3\">State / District</th>\n                <th className=\"py-3 px-3\">Mandi Market</th>\n                <th className=\"py-3 px-3\">Commodity</th>\n                <th className=\"py-3 px-3\">Variety</th>\n                <th className=\"py-3 px-3\">Min Price</th>\n                <th className=\"py-3 px-3\">Max Price</th>\n                <th className=\"py-3 px-3\">Modal Price (Target)</th>\n                <th className=\"py-3 px-3\">Arrival Date</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {records.map((r) => (\n                <tr key={r.id} className=\"hover:bg-slate-50/80 transition-all\">\n                  <td className=\"py-3 px-3 font-semibold text-slate-900\">\n                    {r.state} ({r.district})\n                  </td>\n                  <td className=\"py-3 px-3 text-slate-700\">{r.market}</td>\n                  <td className=\"py-3 px-3 font-bold text-slate-900\">{r.commodity}</td>\n                  <td className=\"py-3 px-3 text-slate-600\">{r.variety}</td>\n                  <td className=\"py-3 px-3 text-slate-600\">\342\202\271{r.minPricePerKg}/kg</td>\n                  <td className=\"py-3 px-3 text-slate-600\">\342\202\271{r.maxPricePerKg}/kg</td>\n                  <td className=\"py-3 px-3 font-extrabold text-emerald-700\">\342\202\271{r.modalPricePerKg} / kg</td>\n                  <td className=\"py-3 px-3 text-slate-500\">{r.arrivalDate}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { MandiPriceRecord, PriceForecast } from \'../types\';\nimport { TrendingUp, Store, DollarSign, Calendar, AlertCircle } from \'lucide-react\';\n\ninterface MarketTrendsCardProps {\n  records: MandiPriceRecord[];\n  forecast: PriceForecast;\n}\n\nexport const MarketTrendsCard: React.FC<MarketTrendsCardProps> = ({ records, forecast }) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <Store className=\"w-5 h-5 text-[#D4A373]\" />\n            <h2 className=\"text-2xl font-serif italic text-[#4A6741]\">AGMARKNET Mandi Feed & Prophet Price Forecast</h2>\n          </div>\n          <p className=\"text-xs text-[#6B6E6B] mt-1\">\n            Official wholesale mandi arrival prices and 30-day time series price trend forecaster.\n          </p>\n        </div>\n\n        <div className=\"bg-[#FDF9F3] px-3.5 py-1.5 rounded-xl border border-[#D4A373]/30 text-xs text-[#8B5E34] font-medium\">\n          Source: <span className=\"font-bold\">Government of India Data.gov.in / AGMARKNET</span>\n        </div>\n      </div>\n\n      {/* Primary Forecast Display Card */}\n      <div className=\"bg-[#4A6741] text-white p-6 rounded-2xl shadow-xs border border-[#3A5033] space-y-4\">\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-white/20 pb-3\">\n          <div>\n            <span className=\"text-xs text-[#D4A373] font-bold uppercase tracking-wider block\">Prophet Forecast Model</span>\n            <h3 className=\"text-lg font-bold text-white\">{forecast.commodity} \342\200\224 Best Selling Market Recommendation</h3>\n          </div>\n          <span className=\"bg-white/10 text-white border border-white/20 text-xs px-3 py-1 rounded-full font-bold\">\n            Trend: {forecast.trend}\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs\">\n          <div className=\"bg-white/10 p-4 rounded-xl border border-white/10\">\n            <span className=\"text-white/80 block mb-1 uppercase tracking-wider text-[10px]\">Latest Observed Modal Price</span>\n            <span className=\"text-2xl font-mono font-bold text-[#D4A373]\">\342\202\271{forecast.observedModalPrice} / kg</span>\n            <span className=\"text-[10px] text-white/70 block mt-1\">Mandi Arrival Feed</span>\n          </div>\n\n          <div className=\"bg-white/10 p-4 rounded-xl border border-white/10\">\n            <span className=\"text-white/80 block mb-1 uppercase tracking-wider text-[10px]\">30-Day Forecasted Modal Price</span>\n            <span className=\"text-2xl font-mono font-bold text-white\">\342\202\271{forecast.forecastedModalPrice} / kg</span>\n            <span className=\"text-[10px] text-white/80 block mt-1 font-mono\">\n              Conf. Interval: \342\202\271{forecast.confidenceInterval[0]} - \342\202\271{forecast.confidenceInterval[1]}\n            </span>\n          </div>\n\n          <div className=\"bg-white/10 p-4 rounded-xl border border-white/10\">\n            <span className=\"text-white/80 block mb-1 uppercase tracking-wider text-[10px]\">Recommended Selling Strategy</span>\n            <span className=\"text-xs font-bold text-white block mt-1\">{forecast.recommendedSellingWindow}</span>\n            <span className=\"text-[10px] text-white/70 block mt-1 font-mono\">Target Date: {forecast.forecastDate}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Observed Mandi Prices Table */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EBE7DF] shadow-xs space-y-4\">\n        <h3 className=\"font-bold text-[#2D302D] text-xs uppercase tracking-wider border-b border-[#EBE7DF] pb-2\">\n          Verified Regional Mandi Arrival Records\n        </h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse text-xs\">\n            <thead>\n              <tr className=\"bg-[#F2EDE4] border-b border-[#D9D4C7] text-[#2D302D] font-bold\">\n                <th className=\"py-3 px-3\">State / District</th>\n                <th className=\"py-3 px-3\">Mandi Market</th>\n                <th className=\"py-3 px-3\">Commodity</th>\n                <th className=\"py-3 px-3\">Variety</th>\n                <th className=\"py-3 px-3\">Min Price</th>\n                <th className=\"py-3 px-3\">Max Price</th>\n                <th className=\"py-3 px-3\">Modal Price (Target)</th>\n                <th className=\"py-3 px-3\">Arrival Date</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#EBE7DF]\">\n              {records.map((r) => (\n                <tr key={r.id} className=\"hover:bg-[#F2EDE4]/40 transition-all\">\n                  <td className=\"py-3 px-3 font-semibold text-[#2D302D]\">\n                    {r.state} ({r.district})\n                  </td>\n                  <td className=\"py-3 px-3 text-[#6B6E6B]\">{r.market}</td>\n                  <td className=\"py-3 px-3 font-bold text-[#2D302D]\">{r.commodity}</td>\n                  <td className=\"py-3 px-3 text-[#6B6E6B]\">{r.variety}</td>\n                  <td className=\"py-3 px-3 text-[#6B6E6B] font-mono\">\342\202\271{r.minPricePerKg}/kg</td>\n                  <td className=\"py-3 px-3 text-[#6B6E6B] font-mono\">\342\202\271{r.maxPricePerKg}/kg</td>\n                  <td className=\"py-3 px-3 font-mono font-bold text-[#4A6741]\">\342\202\271{r.modalPricePerKg} / kg</td>\n                  <td className=\"py-3 px-3 text-[#8C8F8C] font-mono\">{r.arrivalDate}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};"
