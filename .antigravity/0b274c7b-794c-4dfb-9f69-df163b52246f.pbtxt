    instruction: "Fix handleAuth in AuthModal to strictly validate user and error, preventing non-existent accounts from logging in."
    replacement_infos {
      original_chunk {
        target_content: "  const handleAuth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setMessage(null);\n\n    try {\n      if (isSignUp) {\n        const { user, error } = await SupabaseService.signUp(email, password, farmerName || \'Farmer\');\n        if (error) throw error;\n\n        const userId = user?.id || `usr_${Date.now()}`;\n        setSession({\n          user: { id: userId, email, farmerName: farmerName || \'Farmer\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n        setMessage({ type: \'success\', text: \'Account created! Synced with Supabase.\' });\n        if (onAuthSuccess) onAuthSuccess(userId);\n        setTimeout(() => onClose(), 600);\n      } else {\n        const { user, error } = await SupabaseService.signIn(email, password);\n        if (error) throw error;\n\n        const userId = user?.id || \'usr_demo_101\';\n        setSession({\n          user: { id: userId, email, farmerName: (user as any)?.user_metadata?.farmer_name || \'Farmer\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n        setMessage({ type: \'success\', text: \'Logged in successfully!\' });\n        if (onAuthSuccess) onAuthSuccess(userId);\n        setTimeout(() => onClose(), 600);\n      }\n    } catch (err: any) {\n      setMessage({ type: \'error\', text: err.message || \'Authentication failed\' });\n    } finally {\n      setLoading(false);\n    }\n  };"
        replacement_content: "  const handleAuth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setMessage(null);\n\n    try {\n      if (isSignUp) {\n        const { user, error } = await SupabaseService.signUp(email, password, farmerName || \'Farmer\');\n        if (error || !user) {\n          throw new Error(error?.message || \'Failed to create account. Please try again.\');\n        }\n\n        const userId = user.id;\n        setSession({\n          user: { id: userId, email: user.email || email, farmerName: user.farmerName || farmerName || \'Farmer\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n        setMessage({ type: \'success\', text: \'Account created! Synced with Supabase.\' });\n        if (onAuthSuccess) onAuthSuccess(userId);\n        setTimeout(() => onClose(), 600);\n      } else {\n        const { user, error } = await SupabaseService.signIn(email, password);\n        if (error || !user) {\n          throw new Error(error?.message || \'No account found or incorrect email/password. Please sign up or check your credentials.\');\n        }\n\n        const userId = user.id;\n        setSession({\n          user: { id: userId, email: user.email || email, farmerName: user.farmerName || \'Farmer\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n        setMessage({ type: \'success\', text: \'Logged in successfully!\' });\n        if (onAuthSuccess) onAuthSuccess(userId);\n        setTimeout(() => onClose(), 600);\n      }\n    } catch (err: any) {\n      setMessage({\n        type: \'error\',\n        text: err.message || \'No account found or incorrect email/password. Please sign up or check your credentials.\',\n      });\n    } finally {\n      setLoading(false);\n    }\n  };"
      }
      num_matches: 1
    }
  }
