      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\n    background-color: #F9F7F2;\n    color: #2D302D;\n  }\n  \n  h1, h2, h3, .font-serif {\n    font-family: \'Instrument Serif\', Georgia, serif;\n  }\n  \n  code, pre, .font-mono {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n/* Custom scrollbar matching natural tones theme */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #EBE7DF;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #D9D4C7;\n  border-radius: 9999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #4A6741;\n}\n\n/* Utility classes for Natural Tones palette */\n.bg-natural-bg { background-color: #F9F7F2; }\n.bg-natural-stone { background-color: #EBE7DF; }\n.bg-natural-stone-light { background-color: #F2EDE4; }\n.bg-natural-card { background-color: #FFFFFF; }\n.bg-natural-sage { background-color: #F2F8F0; }\n.bg-natural-cream { background-color: #FDF9F3; }\n.bg-natural-forest { background-color: #4A6741; }\n.bg-natural-forest-dark { background-color: #3A5033; }\n.bg-natural-terracotta { background-color: #D4A373; }\n\n.text-natural-forest { color: #4A6741; }\n.text-natural-terracotta { color: #D4A373; }\n.text-natural-earth { color: #8B5E34; }\n.text-natural-main { color: #2D302D; }\n.text-natural-muted { color: #6B6E6B; }\n.text-natural-light { color: #8C8F8C; }\n\n.border-natural-stone { border-color: #D9D4C7; }\n.border-natural-light { border-color: #EBE7DF; }\n.border-natural-forest { border-color: #4A6741; }\n"
    }
