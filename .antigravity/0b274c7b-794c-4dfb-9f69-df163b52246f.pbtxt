        }
        lines {
          text: "   */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  static calculateHouseholdDailyRDA(ageGroups: HouseholdAgeGroups): NutrientTarget {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const target: NutrientTarget = {"
