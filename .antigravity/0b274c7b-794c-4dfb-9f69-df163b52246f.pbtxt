    instruction: "Add initialMode and onAuthSuccess props to AuthModal"
    replacement_infos {
      original_chunk {
        target_content: "interface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  session: UserSession;\n  setSession: React.Dispatch<React.SetStateAction<UserSession>>;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  session,\n  setSession,\n}) => {\n  const [isSignUp, setIsSignUp] = useState(false);\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [farmerName, setFarmerName] = useState(\'\');\n  const [message, setMessage] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleAuth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setMessage(null);\n\n    try {\n      if (isSignUp) {\n        const { user, error } = await SupabaseService.signUp(email, password, farmerName || \'Ramesh Kumar\');\n        if (error) throw error;\n\n        setMessage({ type: \'success\', text: \'Account created! Profile synced with Supabase PostgreSQL.\' });\n        setSession({\n          user: { id: user?.id || \'usr_1\', email, farmerName: farmerName || \'Ramesh Kumar\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n      } else {\n        const { user, error } = await SupabaseService.signIn(email, password);\n        if (error) throw error;\n\n        setMessage({ type: \'success\', text: \'Logged in successfully! RLS protected state active.\' });\n        setSession({\n          user: { id: user?.id || \'usr_1\', email, farmerName: \'Ramesh Kumar\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n      }\n    } catch (err: any) {\n      setMessage({ type: \'error\', text: err.message || \'Authentication failed\' });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    await SupabaseService.signOut();\n    setSession({ user: null, isLoggedIn: false, isOffline: false, lastSyncedAt: new Date().toLocaleTimeString() });\n    onClose();\n  };"
        replacement_content: "interface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  session: UserSession;\n  setSession: React.Dispatch<React.SetStateAction<UserSession>>;\n  initialMode?: \'signin\' | \'signup\';\n  onAuthSuccess?: (userId: string) => void;\n  onSignOut?: () => void;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  session,\n  setSession,\n  initialMode = \'signin\',\n  onAuthSuccess,\n  onSignOut,\n}) => {\n  const [isSignUp, setIsSignUp] = useState(initialMode === \'signup\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [farmerName, setFarmerName] = useState(\'\');\n  const [message, setMessage] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  React.useEffect(() => {\n    setIsSignUp(initialMode === \'signup\');\n  }, [initialMode, isOpen]);\n\n  if (!isOpen) return null;\n\n  const handleAuth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setMessage(null);\n\n    try {\n      if (isSignUp) {\n        const { user, error } = await SupabaseService.signUp(email, password, farmerName || \'Farmer\');\n        if (error) throw error;\n\n        const userId = user?.id || `usr_${Date.now()}`;\n        setSession({\n          user: { id: userId, email, farmerName: farmerName || \'Farmer\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n        setMessage({ type: \'success\', text: \'Account created! Synced with Supabase.\' });\n        if (onAuthSuccess) onAuthSuccess(userId);\n        setTimeout(() => onClose(), 600);\n      } else {\n        const { user, error } = await SupabaseService.signIn(email, password);\n        if (error) throw error;\n\n        const userId = user?.id || \'usr_demo_101\';\n        setSession({\n          user: { id: userId, email, farmerName: user?.user_metadata?.farmer_name || \'Farmer\' },\n          isLoggedIn: true,\n          isOffline: false,\n          lastSyncedAt: new Date().toLocaleTimeString(),\n        });\n        setMessage({ type: \'success\', text: \'Logged in successfully!\' });\n        if (onAuthSuccess) onAuthSuccess(userId);\n        setTimeout(() => onClose(), 600);\n      }\n    } catch (err: any) {\n      setMessage({ type: \'error\', text: err.message || \'Authentication failed\' });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    await SupabaseService.signOut();\n    setSession({ user: null, isLoggedIn: false, isOffline: false, lastSyncedAt: new Date().toLocaleTimeString() });\n    if (onSignOut) onSignOut();\n    onClose();\n  };"
      }
      num_matches: 1
    }
  }
}
