    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export const Navbar: React.FC<NavbarProps> = ({\n  session,\n  activeTab,\n  setActiveTab,\n  onOpenAuth,\n  onLoadDemoScenario,\n}) => {\n  const tabs = [\n    { id: \'dashboard\', label: \'Dashboard\' },\n    { id: \'profile\', label: \'Farm & Family\' },\n    { id: \'nutrition\', label: \'Nutrition\' },\n    { id: \'crops\', label: \'Crop Plan & Yield\' },\n    { id: \'climate\', label: \'Climate Alerts\' },\n    { id: \'market\', label: \'Mandi Prices\' },\n    { id: \'allocation\', label: \'Harvest Allocation\' },\n    { id: \'gemini\', label: \'AI Explainer & Voice\' },\n    { id: \'provenance\', label: \'Data Provenance\' },\n  ];\n\n  return (\n    <header className=\"bg-slate-900 text-slate-100 border-b border-slate-800 sticky top-0 z-40 shadow-md\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Brand */}\n          <div className=\"flex items-center space-x-3 cursor-pointer\" onClick={() => setActiveTab(\'dashboard\')}>\n            <div className=\"w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center shadow-lg shadow-emerald-900/30\">\n              <Sprout className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-bold text-lg tracking-tight text-white\">NutriHarvest AI</span>\n                <span className=\"bg-emerald-950 text-emerald-400 text-xs px-2 py-0.5 rounded-full border border-emerald-800 font-medium\">\n                  Hackathon Prototype\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400 font-normal\">Personalized Crop-to-Plate Planner</p>\n            </div>\n          </div>\n\n          {/* Action buttons */}\n          <div className=\"flex items-center space-x-3\">\n            {/* Status indicator */}\n            <div className=\"hidden md:flex items-center space-x-1.5 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 text-xs text-slate-300\">\n              {session.isOffline ? (\n                <>\n                  <WifiOff className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>Offline (Cached)</span>\n                </>\n              ) : (\n                <>\n                  <Wifi className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n                  <span>Live Services Connected</span>\n                </>\n              )}\n            </div>\n\n            {/* Load Demo Scenario button */}\n            <button\n              onClick={onLoadDemoScenario}\n              className=\"flex items-center space-x-1.5 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-700/50 text-xs px-3 py-1.5 rounded-lg font-medium transition-all\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Load Demo Scenario</span>\n            </button>\n\n            {/* Supabase Auth */}\n            <button\n              onClick={onOpenAuth}\n              className=\"flex items-center space-x-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium transition-all\"\n            >\n              <User className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>{session.user ? session.user.farmerName || session.user.email : \'Login / Supabase\'}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Navigation Tabs Bar */}\n        <div className=\"flex space-x-1 overflow-x-auto pb-2 pt-1 no-scrollbar border-t border-slate-800/60\">\n          {tabs.map((tab) => {\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id)}\n                className={`whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                  isActive\n                    ? \'bg-emerald-600 text-white shadow-sm font-semibold\'\n                    : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n                }`}\n              >\n                {tab.label}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "export const Navbar: React.FC<NavbarProps> = ({\n  session,\n  activeTab,\n  setActiveTab,\n  onOpenAuth,\n  onLoadDemoScenario,\n}) => {\n  const tabs = [\n    { id: \'dashboard\', label: \'Dashboard\' },\n    { id: \'profile\', label: \'Farm & Family\' },\n    { id: \'nutrition\', label: \'Nutrition\' },\n    { id: \'crops\', label: \'Crop Plan & Yield\' },\n    { id: \'climate\', label: \'Climate Alerts\' },\n    { id: \'market\', label: \'Mandi Prices\' },\n    { id: \'allocation\', label: \'Harvest Allocation\' },\n    { id: \'gemini\', label: \'AI Explainer & Voice\' },\n    { id: \'provenance\', label: \'Data Provenance\' },\n  ];\n\n  return (\n    <header className=\"bg-[#EBE7DF] text-[#2D302D] border-b border-[#D9D4C7] sticky top-0 z-40 shadow-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Brand */}\n          <div className=\"flex items-center space-x-3 cursor-pointer\" onClick={() => setActiveTab(\'dashboard\')}>\n            <div className=\"w-9 h-9 rounded-lg bg-[#4A6741] flex items-center justify-center text-white font-bold shadow-xs\">\n              <Sprout className=\"w-5 h-5 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-bold text-xl tracking-tight text-[#4A6741]\">NutriHarvest AI</span>\n                <span className=\"bg-[#F2F8F0] text-[#4A6741] text-[10px] px-2 py-0.5 rounded-md border border-[#4A6741]/20 font-semibold uppercase tracking-wider\">\n                  Hackathon Prototype\n                </span>\n              </div>\n              <p className=\"text-xs text-[#6B6E6B] font-medium\">Personalized Crop-to-Plate Planner</p>\n            </div>\n          </div>\n\n          {/* Action buttons */}\n          <div className=\"flex items-center space-x-2 sm:space-x-3\">\n            {/* Status indicator */}\n            <div className=\"hidden md:flex items-center space-x-1.5 bg-[#F2EDE4] px-2.5 py-1.5 rounded-lg border border-[#D9D4C7] text-xs text-[#6B6E6B]\">\n              {session.isOffline ? (\n                <>\n                  <WifiOff className=\"w-3.5 h-3.5 text-[#D4A373]\" />\n                  <span>Offline (Cached)</span>\n                </>\n              ) : (\n                <>\n                  <Wifi className=\"w-3.5 h-3.5 text-[#4A6741] animate-pulse\" />\n                  <span className=\"font-medium text-[#2D302D]\">Live Services Connected</span>\n                </>\n              )}\n            </div>\n\n            {/* Load Demo Scenario button */}\n            <button\n              onClick={onLoadDemoScenario}\n              className=\"flex items-center space-x-1.5 bg-[#4A6741] hover:bg-[#3A5033] text-white text-xs px-3 py-1.5 rounded-lg font-medium shadow-xs transition-all cursor-pointer\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" />\n              <span>Load Demo Scenario</span>\n            </button>\n\n            {/* Supabase Auth */}\n            <button\n              onClick={onOpenAuth}\n              className=\"flex items-center space-x-1.5 bg-[#F2EDE4] hover:bg-[#D9D4C7] text-[#2D302D] border border-[#D9D4C7] text-xs px-3 py-1.5 rounded-lg font-medium transition-all cursor-pointer\"\n            >\n              <User className=\"w-3.5 h-3.5 text-[#6B6E6B]\" />\n              <span>{session.user ? session.user.farmerName || session.user.email : \'Login / Supabase\'}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Navigation Tabs Bar */}\n        <div className=\"flex space-x-1 overflow-x-auto pb-2 pt-1 no-scrollbar border-t border-[#D9D4C7]/60\">\n          {tabs.map((tab) => {\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id)}\n                className={`whitespace-nowrap px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer ${\n                  isActive\n                    ? \'bg-[#D9D4C7] text-[#4A6741] font-bold shadow-xs\'\n                    : \'text-[#6B6E6B] hover:text-[#2D302D] hover:bg-[#D9D4C7]/40 font-medium\'\n                }`}\n              >\n                {tab.label}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </header>\n  );\n};"
    }
