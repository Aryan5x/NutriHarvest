        target_content: "      {/* Verified Data Source Banner */}\n      <DemoBanner />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {activeTab === \'dashboard\' && (\n          <ExecutiveDashboard\n            farmer={farmer}\n            farm={farm}\n            coverage={nutritionCoverage}\n            candidates={candidates}\n            weather={weatherObs}\n            alerts={weatherAlerts}\n            forecast={priceForecast}\n            allocation={harvestAllocation}\n            metrics={modelMetrics}\n            onNavigateTab={setActiveTab}\n          />\n        )}\n\n        {activeTab === \'profile\' && (\n          <FarmerProfileWizard\n            farmer={farmer}\n            setFarmer={setFarmer}\n            farm={farm}\n            setFarm={setFarm}\n            userId={session.user?.id || \'\'}\n            onSaveAndGenerate={() => {\n              recalculateAgents();\n              setActiveTab(\'dashboard\');\n            }}\n          />\n        )}\n\n        {activeTab === \'nutrition\' && (\n          <NutritionDashboard\n            coverage={nutritionCoverage}\n            target={nutritionTarget}\n            achieved={nutritionAchieved}\n          />\n        )}\n\n        {activeTab === \'crops\' && (\n          <CropPlanCard\n            candidates={candidates}\n            metrics={modelMetrics}\n          />\n        )}\n\n        {activeTab === \'progress\' && (\n          <FarmProgressTracker\n            userId={session.user?.id || \'demo-user\'}\n            defaultCropName={candidates[0]?.name || \'Wheat\'}\n            defaultPlotName=\"Main Plot A\"\n          />\n        )}\n\n        {activeTab === \'yield_tracking\' && (\n          <YieldTrackingModal\n            userId={session.user?.id || \'demo-user\'}\n            candidateCrops={candidates}\n          />\n        )}\n\n        {activeTab === \'climate\' && (\n          <ClimateWidget\n            weather={weatherObs}\n            alerts={weatherAlerts}\n          />\n        )}\n\n        {activeTab === \'market\' && (\n          <MarketTrendsCard\n            records={mandiRecords}\n            forecast={priceForecast}\n          />\n        )}"
        replacement_content: "      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {activeTab === \'dashboard\' && (\n          <ExecutiveDashboard\n            farmer={farmer}\n            farm={farm}\n            coverage={nutritionCoverage}\n            candidates={candidates}\n            weather={weatherObs}\n            alerts={weatherAlerts}\n            forecast={priceForecast}\n            allocation={harvestAllocation}\n            metrics={modelMetrics}\n            onNavigateTab={setActiveTab}\n            onRefresh={recalculateAgents}\n          />\n        )}\n\n        {activeTab === \'profile\' && (\n          <FarmerProfileWizard\n            farmer={farmer}\n            setFarmer={setFarmer}\n            farm={farm}\n            setFarm={setFarm}\n            userId={session.user?.id || \'\'}\n            onSaveAndGenerate={() => {\n              recalculateAgents();\n              setActiveTab(\'dashboard\');\n            }}\n          />\n        )}\n\n        {activeTab === \'nutrition\' && (\n          <NutritionDashboard\n            coverage={nutritionCoverage}\n            target={nutritionTarget}\n            achieved={nutritionAchieved}\n            sourceInfo={nutritionSourceInfo}\n            onRefresh={recalculateAgents}\n            onNavigateToFarm={() => setActiveTab(\'profile\')}\n          />\n        )}\n\n        {activeTab === \'crops\' && (\n          <CropPlanCard\n            candidates={candidates}\n            metrics={modelMetrics}\n            onRefresh={recalculateAgents}\n          />\n        )}\n\n        {activeTab === \'progress\' && (\n          <FarmProgressTracker\n            userId={session.user?.id || \'demo-user\'}\n            defaultCropName={candidates[0]?.name || \'Wheat\'}\n            defaultPlotName=\"Main Plot A\"\n            onRefresh={recalculateAgents}\n          />\n        )}\n\n        {activeTab === \'yield_tracking\' && (\n          <YieldTrackingModal\n            userId={session.user?.id || \'demo-user\'}\n            candidateCrops={candidates}\n            onYieldUpdated={recalculateAgents}\n          />\n        )}\n\n        {activeTab === \'climate\' && (\n          <ClimateWidget\n            weather={weatherObs}\n            alerts={weatherAlerts}\n            onRefresh={recalculateAgents}\n          />\n        )}\n\n        {activeTab === \'market\' && (\n          <MarketTrendsCard\n            records={mandiRecords}\n            forecast={priceForecast}\n            onRefresh={recalculateAgents}\n          />\n        )}"
      }
      num_matches: 1
    }
  }
}
